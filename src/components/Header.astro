---
import Logo from './Logo.astro';

interface Props {
  ctaLabel?: string;
  ctaHref?: string;
}
const { ctaHref = '/join', ctaLabel = 'Sign up your shop' } = Astro.props;
// Very small phones show a shorter label for the default button
const ctaShort = ctaLabel === 'Sign up your shop' ? 'Sign up' : ctaLabel;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/businesses', label: 'Businesses', also: ['/how-it-works'] },
  { href: '/farm-shops', label: 'Farm shops' },
  { href: '/events', label: 'Markets & Events' },
  // For shoppers: adding Gentifi to their AI assistant
  { href: '/connector', label: 'Ask your AI' },
  // The toolkit and the standards it builds on, for developers
  { href: '/toolkit', label: 'Developers', also: ['/standards'] },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <Logo href="/" />

    <a class="btn btn--primary site-header__cta" href={ctaHref}><span class="cta-long">{ctaLabel}</span><span class="cta-short">{ctaShort}</span></a>

    <!-- One row of links: beside the logo on wide screens, a swipeable row underneath on narrow ones -->
    <nav class="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={path === l.href || l.also?.includes(path) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  // On narrow screens, scroll the row so the current page's link is in view.
  document.querySelector('.site-nav [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
</script>

<style>
  .site-header {
    position: relative;
    background: var(--teal);
    color: var(--white);
    border-bottom: 1px solid var(--teal-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
  }
  .site-header__inner > :global(.logo) { flex-shrink: 0; margin-right: auto; }

  ul { list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--on-teal-muted);
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--white); background: var(--teal-raised); }
  .site-header__cta { flex-shrink: 0; min-height: 40px; padding: 8px 16px; font-size: 0.9rem; white-space: nowrap; }

  /* Narrow: logo and sign-up button, then the links in a row that scrolls sideways */
  .site-header__inner { flex-wrap: wrap; row-gap: 6px; padding-top: 12px; }
  .site-nav {
    order: 3;
    flex-basis: 100%;
    margin-inline: calc(var(--gutter) * -1);
    /* Links have their own 12px padding, so their text lines up with the logo */
    padding: 0 calc(var(--gutter) - 12px) 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav::-webkit-scrollbar { display: none; }
  .site-nav ul { display: flex; gap: 2px; }

  /* Very small phones: a shorter button label so it stays beside the logo */
  .cta-short { display: none; }
  @media (max-width: 359px) {
    .cta-long { display: none; }
    .cta-short { display: inline; }
  }

  /* Wide: links beside the logo, before the sign-up button */
  @media (min-width: 1000px) {
    .site-header__inner { flex-wrap: nowrap; gap: 20px; padding-top: 0; }
    .site-header__inner > :global(.logo) { margin-right: 0; }
    .site-nav { order: 0; flex-basis: auto; margin: 0 0 0 auto; padding: 0; overflow: visible; }
    .site-header__cta { order: 1; }
  }
</style>
