---
import Logo from './Logo.astro';

interface Props {
  ctaHref?: string;
}
const { ctaHref = '/#waitlist' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/#add', label: 'Add to your agent' },
  { href: '/businesses', label: 'Businesses' },
  { href: '/toolkit', label: 'Toolkit' },
  { href: '/standards', label: 'Standards' },
  { href: '/b/demo-business', label: 'Scan demo' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <Logo href="/" />
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--primary site-header__cta" href={ctaHref}>Join the waitlist</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--teal);
    color: var(--white);
    border-bottom: 1px solid var(--teal-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }
  nav { margin-left: auto; display: none; }
  ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--on-teal-muted);
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--white); background: var(--teal-raised); }
  .site-header__cta { margin-left: auto; min-height: 40px; padding: 8px 16px; font-size: 0.9rem; }

  @media (min-width: 960px) {
    nav { display: block; }
    .site-header__cta { margin-left: 0; }
  }
</style>
