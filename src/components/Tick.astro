---
// The ticked circle that follows the wordmark: "this business is agent-ready".
interface Props {
  size?: number | string;
  circle?: string;
  tick?: string;
  label?: string;
}
const { size = 20, circle = 'var(--copper)', tick = 'var(--white)', label } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style="flex-shrink:0"
>
  <circle cx="12" cy="12" r="11" fill={circle} />
  <path d="M6.5 12.5 L10.5 16.5 L17.5 8" fill="none" stroke={tick} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
</svg>
