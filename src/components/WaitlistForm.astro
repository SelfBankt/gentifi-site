---
// Sign-ups go to a Google Sheet through a small Apps Script web app (see waitlist/apps-script.gs).
// Paste the web app's /exec URL here. While it's empty, the form explains that nothing was sent.
const WAITLIST_ENDPOINT = '';

interface Props {
  role?: 'business' | 'farm' | 'developer' | 'customer' | 'organiser';
  tone?: 'dark' | 'light'; // background it sits on
}
const { role = 'business', tone = 'dark' } = Astro.props;
const roles = [
  { value: 'business', label: 'A business owner' },
  { value: 'farm', label: 'A farm shop, farm or food producer' },
  { value: 'developer', label: 'A developer' },
  { value: 'customer', label: 'A customer' },
  { value: 'organiser', label: 'Organising a show, market, high street or trade body' },
];
---
<form class:list={['waitlist', `waitlist--${tone}`]} action={WAITLIST_ENDPOINT || undefined} method="post" data-waitlist-form data-endpoint={WAITLIST_ENDPOINT}>
  <div class="field">
    <label for="wl-name">Your name</label>
    <input id="wl-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="wl-email">Email</label>
    <input id="wl-email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="wl-role">I'm joining as</label>
    <select id="wl-role" name="role" required>
      {roles.map((r) => <option value={r.value} selected={r.value === role}>{r.label}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="wl-business">Business name <span class="opt">(optional)</span></label>
    <input id="wl-business" name="business" type="text" autocomplete="organization" />
  </div>
  <div class="field field--wide">
    <label for="wl-postcode">Postcode area <span class="opt">(optional)</span></label>
    <input id="wl-postcode" name="postcode" type="text" autocomplete="postal-code" maxlength="8" />
  </div>
  <div class="trap" aria-hidden="true">
    <label for="wl-website">Leave this empty</label>
    <input id="wl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="field--wide actions">
    <button class:list={['btn', tone === 'light' ? 'btn--teal' : 'btn--primary']} type="submit">Join the waitlist</button>
    <p class="note">We'll only email you about Gentifi's launch. <a href="/privacy">How we use your details</a></p>
  </div>
  <p class="status field--wide" role="status" aria-live="polite"></p>
</form>

<script>
  // A link such as /?role=organiser#waitlist chooses the role in advance.
  const askedRole = new URLSearchParams(location.search).get('role');
  document.querySelectorAll<HTMLSelectElement>('form[data-waitlist-form] select[name="role"]').forEach((select) => {
    if (askedRole && [...select.options].some((o) => o.value === askedRole)) select.value = askedRole;
  });

  document.querySelectorAll<HTMLFormElement>('form[data-waitlist-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const say = (text: string) => { if (status) status.textContent = text; };
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        say('Thanks. The waitlist isn’t connected yet, so nothing was sent.');
        return;
      }
      const data = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      data.set('page', location.pathname);
      if (button) button.disabled = true;
      say('Sending…');
      try {
        // A simple form POST: Apps Script answers it without a CORS preflight
        const res = await fetch(endpoint, { method: 'POST', body: data });
        const body = await res.json();
        if (body.ok) {
          form.reset();
          say('Thanks, you’re on the list. We’ll be in touch.');
        } else {
          say(body.error || 'That didn’t go through. Please check your details and try again.');
        }
      } catch {
        say('That didn’t go through, probably a connection problem. Please try again.');
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

<style>
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .note a { color: inherit; font-weight: 600; }
  .waitlist {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .waitlist { grid-template-columns: 1fr 1fr; }
    .field--wide { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: 6px; }
  label { font-size: 0.9rem; font-weight: 600; }
  .opt { font-weight: 400; color: var(--on-teal-muted); }
  input, select {
    font: inherit;
    min-height: 48px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--teal-line);
    background: var(--teal-raised);
    color: var(--white);
    width: 100%;
  }
  input:focus-visible, select:focus-visible { border-color: var(--copper); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 4px; }
  .note { font-size: 0.85rem; color: var(--on-teal-muted); }
  .status:empty { display: none; }
  .status {
    padding: 12px 16px;
    border: 1px solid var(--copper);
    border-radius: var(--radius-sm);
    color: var(--white);
  }

  /* On a white background */
  .waitlist--light label { color: var(--ink); }
  .waitlist--light .opt, .waitlist--light .note { color: var(--ink-muted); }
  .waitlist--light input, .waitlist--light select { background: var(--white); border-color: var(--border); color: var(--ink); }
  .waitlist--light input:focus-visible, .waitlist--light select:focus-visible { border-color: var(--teal); }
  .waitlist--light .status { border-color: var(--teal); color: var(--ink); }
</style>
