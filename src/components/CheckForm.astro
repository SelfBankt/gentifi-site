---
// "Ask for your AI visibility check": goes to the "AI checks" tab through the waitlist's Apps Script
// (see waitlist/apps-script.gs), which emails the Gentifi team.
const ENDPOINT = 'https://script.google.com/macros/s/AKfycbz-9hOzXLragpCbln-n2aJJEUMvNya6DIM3TiQs54R7eeWS-KLVWMUkOL7tVIFCGWSX/exec';
---
<form class="check" action={ENDPOINT} method="post" data-check-form data-endpoint={ENDPOINT}>
  <input type="hidden" name="form" value="check" />
  <div class="field"><label for="c-business">Business name</label><input id="c-business" name="business" autocomplete="organization" required /></div>
  <div class="field"><label for="c-site">Website</label><input id="c-site" name="site_url" inputmode="url" placeholder="yourshop.co.uk" required /></div>
  <div class="field"><label for="c-email">Your email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
  <div class="field"><label for="c-town">Town <span class="opt">(optional)</span></label><input id="c-town" name="town" autocomplete="address-level2" /></div>
  <div class="trap" aria-hidden="true"><label for="c-trap">Leave this empty</label><input id="c-trap" name="trap" tabindex="-1" autocomplete="off" /></div>
  <div class="actions">
    <button class="btn btn--teal" type="submit">Get my AI visibility check</button>
    <p class="note">We’ll email you a one-page report. <a href="/privacy#check">How we use your details</a></p>
  </div>
  <p class="status" role="status" aria-live="polite"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-check-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.status')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
      body.set('page', location.pathname);
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        // A simple form POST: Apps Script answers it without a CORS preflight
        const reply = await (await fetch(form.dataset.endpoint!, { method: 'POST', body })).json();
        if (reply.ok) {
          form.reset();
          status.textContent = 'Thank you. We’ll check your website and email you the report.';
        } else {
          status.textContent = reply.error || 'That didn’t go through. Please check your details and try again.';
        }
      } catch {
        status.textContent = 'That didn’t go through, probably a connection problem. Please try again.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .check { display: grid; gap: 14px; background: var(--white); border-radius: var(--radius); padding: 24px; }
  @media (min-width: 720px) { .check { grid-template-columns: repeat(4, 1fr); align-items: end; } .actions, .status { grid-column: 1 / -1; } }
  .field { display: grid; gap: 6px; }
  label { font-weight: 600; font-size: 0.9rem; color: var(--ink); }
  .opt { font-weight: 400; color: var(--ink-muted); }
  input { font: inherit; min-height: 48px; padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--white); color: var(--ink); width: 100%; }
  input:focus-visible { border-color: var(--teal); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .note { font-size: 0.85rem; color: var(--ink-muted); }
  .note a { color: var(--teal); font-weight: 600; }
  .status:empty { display: none; }
  .status { padding: 12px 16px; border: 1px solid var(--teal); border-radius: var(--radius-sm); color: var(--ink); }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
