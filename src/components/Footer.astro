---
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo size="sm" />
      <p>Helping local businesses get found and bought through AI agents.</p>
      <p class="site-footer__open">Open source, under the Apache 2.0 licence. Built on open standards.</p>
    </div>
    <ul class="site-footer__links">
      <li><a href="/#shoppers">For shoppers</a></li>
      <li><a href="/businesses">For businesses</a></li>
      <li><a href="/how-it-works">How it works</a></li>
      <li><a href="/toolkit">Open-source toolkit</a></li>
      <li><a href="/standards">Open standards</a></li>
      <li><a href="/b/demo-business">Try a scan</a></li>
      <li><a href="/#waitlist">Waitlist</a></li>
      <li><a href="https://github.com/SelfBankt">GitHub</a></li>
    </ul>
  </div>
  <div class="container site-footer__note">
    <p>Early preview. Gentifi isn't live yet, so some buttons show a preview of what's coming.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal);
    color: var(--on-teal-muted);
    border-top: 1px solid var(--teal-line);
    padding-block: 48px 32px;
    font-size: 0.92rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
  }
  .site-footer__brand { max-width: 26rem; display: grid; gap: 14px; }
  .site-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .site-footer__links a { color: var(--white); }
  .site-footer__note {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--teal-line);
    font-size: 0.82rem;
  }
  .site-footer__open { color: var(--white); }
</style>
