---
import Logo from './Logo.astro';

const groups = [
  { title: 'For businesses', links: [
    { href: '/join', label: 'Sign up your shop' },
    { href: '/#ai-optimisation', label: 'AI visibility check' },
    { href: '/businesses', label: 'What you get' },
    { href: '/how-it-works', label: 'How it works' },
    { href: '/farm-shops', label: 'Farm shops' },
  ] },
  { title: 'For shoppers', links: [
    { href: '/b/demo-business', label: 'Try the demo' },
    { href: '/connector', label: 'The Gentifi connector' },
  ] },
  { title: 'Gentifi', links: [
    { href: '/toolkit', label: 'Developers' },
    { href: '/standards', label: 'Open standards' },
    { href: '/#waitlist', label: 'Stay in touch' },
    { href: '/privacy', label: 'Privacy' },
  ] },
];
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo size="sm" />
      <p>Making local businesses findable, bookable and buyable through AI assistants.</p>
      <p class="site-footer__open">Open source, under the Apache 2.0 licence. Built on open standards.</p>
    </div>
    <nav class="site-footer__groups" aria-label="Footer">
      {groups.map((g) => (
        <div>
          <h2 class="site-footer__heading">{g.title}</h2>
          <ul class="site-footer__links">{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="container site-footer__note">
    <p>Early days: live in Claude and ChatGPT, starting in Bristol and South Gloucestershire. Anything marked “coming next” isn’t built yet.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal);
    color: var(--on-teal-muted);
    border-top: 1px solid var(--teal-line);
    padding-block: 48px 32px;
    font-size: 0.92rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
  }
  .site-footer__brand { max-width: 26rem; display: grid; gap: 14px; }
  .site-footer__groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); gap: 28px 40px; flex: 1 1 320px; min-width: 0; max-width: 640px; }
  .site-footer__heading { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--copper); margin-bottom: 10px; }
  .site-footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .site-footer__links a { color: var(--white); }
  .site-footer__note {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--teal-line);
    font-size: 0.82rem;
  }
  .site-footer__open { color: var(--white); }
</style>
