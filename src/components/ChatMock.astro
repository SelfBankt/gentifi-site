---
// Illustrative agent conversation for the hero. Generic chat styling (not any
// real app's UI) and a fictional business. Ends with the customer confirming.
import Mark from './Mark.astro';

interface Props {
  tone?: 'dark' | 'light'; // background it sits on
}
const { tone = 'dark' } = Astro.props;
---
<figure class:list={['chat', `chat--${tone}`]}>
  <figcaption class="chat__caption">Illustration · fictional business</figcaption>
  <div class="chat__window">
    <div class="chat__bar"><span class="chat__dot"></span><span class="chat__dot"></span><span class="chat__dot"></span><span class="chat__title">Your AI assistant</span></div>
    <div class="chat__body">
      <p class="msg msg--you">Which farm near me has eggs this week? Reserve a dozen for Saturday.</p>
      <div class="msg msg--agent">
        <p>Hollow Lane Farm Shop has free-range eggs in stock, 2 miles away.</p>
        <div class="result">
          <div class="result__head">
            <span class="result__avatar" aria-hidden="true">HL</span>
            <div>
              <p class="result__name">Hollow Lane Farm Shop</p>
              <p class="result__via"><Mark size={12} color="var(--teal)" stroke={13} />via Gentifi</p>
            </div>
          </div>
          <dl class="result__rows">
            <div><dt>Free-range eggs, dozen</dt><dd>£3.20</dd></div>
            <div><dt>Collect</dt><dd>Sat, 9am–5pm</dd></div>
          </dl>
        </div>
        <p>Shall I reserve one dozen for Saturday collection?</p>
        <div class="confirm" aria-hidden="true">
          <span class="confirm__yes">Confirm reservation</span>
          <span class="confirm__no">Change</span>
        </div>
      </div>
      <p class="chat__note">Your AI asks. You confirm.</p>
    </div>
  </div>
</figure>

<style>
  .chat { margin: 0; width: 100%; }
  .chat__caption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--on-teal-muted);
    margin-bottom: 10px;
    text-align: right;
  }
  .chat--light .chat__caption { color: var(--ink-muted); }
  .chat--light .chat__window { border-color: var(--border); }
  .chat__window {
    background: var(--white);
    color: var(--teal);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--teal-line);
  }
  .chat__bar {
    display: flex; align-items: center; gap: 6px;
    padding: 12px 16px;
    background: var(--grey);
  }
  .chat__dot { width: 10px; height: 10px; border-radius: 50%; background: #C9D2DC; }
  .chat__title { margin-left: 8px; font-size: 0.82rem; font-weight: 600; color: var(--ink-muted); }
  .chat__body { padding: 20px; display: grid; gap: 14px; font-size: 0.93rem; line-height: 1.5; }
  .msg { margin: 0; max-width: 92%; }
  .msg--you {
    justify-self: end;
    background: var(--teal);
    color: var(--white);
    padding: 10px 14px;
    border-radius: 16px 16px 4px 16px;
  }
  .msg--agent { display: grid; gap: 10px; color: var(--ink); }
  .result { border: 1px solid var(--border); border-radius: 14px; padding: 12px 14px; display: grid; gap: 10px; }
  .result__head { display: flex; gap: 10px; align-items: center; }
  .result__avatar {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--grey);
    display: grid; place-items: center;
    font-size: 0.8rem; font-weight: 700;
  }
  .result__name { font-weight: 700; line-height: 1.25; }
  .result__via { display: flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-muted); }
  .result__rows { margin: 0; display: grid; gap: 4px; font-size: 0.88rem; }
  .result__rows div { display: flex; justify-content: space-between; gap: 12px; }
  .result__rows dt { color: var(--ink-muted); }
  .result__rows dd { margin: 0; font-weight: 600; }
  .confirm { display: flex; gap: 8px; flex-wrap: wrap; }
  .confirm span { padding: 8px 14px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }
  .confirm__yes { background: var(--copper); color: var(--teal); }
  .confirm__no { border: 1px solid var(--border); }
  .chat__note { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-muted); text-align: center; border-top: 1px solid var(--grey); padding-top: 12px; }
</style>
