---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WindowSticker from '../components/WindowSticker.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import ChatMock from '../components/ChatMock.astro';
import ApprovalDialog from '../components/ApprovalDialog.astro';
import ConceptNotice from '../components/ConceptNotice.astro';
import Tick from '../components/Tick.astro';

const githubUrl = 'https://github.com/SelfBankt/gentifi-toolkit';
const toolkitZip = `${githubUrl}/archive/refs/heads/main.zip`;

const steps = [
  { title: 'Add your business', body: 'We turn your products, prices, inventory and services into something AI agents can read and act on.' },
  { title: 'Put up your sticker', body: 'Customers scan it to add your business to the AI agent they already use.' },
  { title: 'Customers just ask', body: 'Their agent checks your stock, prices and times, then books or buys once they say yes.' },
];

const asks = [
  'Which farm near me has eggs this week?',
  'Book a table for four on Friday at 7.',
  'Find a plumber available on Tuesday.',
];

const control = [
  'Customers approve every connection, in their own app.',
  'Their agent asks before every booking or order.',
  'Businesses only get their details when they choose to book or buy.',
];
---
<Base
  title="Gentifi: agent-ready business"
  description="Gentifi helps local businesses get found and bought through AI agents like Claude and ChatGPT. Open source and built on open standards."
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__inner">
        <div class="hero__head">
          <span class="eyebrow">Claude · ChatGPT · Hermes · any agent</span>
          <h1 class="hero__title">Agent-ready <span class="hero__nowrap">business<Tick size="0.72em" tick="var(--teal)" /></span></h1>
          <p class="hero__lede">
            Gentifi helps local businesses get found and bought through AI agents like Claude and ChatGPT.
            It's open source and built on open standards.
          </p>
        </div>

        <div class="hero__row">
          <figure class="hero__sticker">
            <WindowSticker />
            <figcaption>Scan the code with your phone: it opens a demo business.</figcaption>
          </figure>

          <div class="hero-actions">
            <div class="hero-actions__part">
              <p class="hero-actions__label">Shopping?</p>
              <p class="hero-actions__text">Add Gentifi to the AI agent you already use, then just ask for what you need.</p>
              <div class="hero-actions__buttons">
                <a class="btn btn--primary" href="#shoppers">Add to your agent</a>
                <a class="btn btn--ghost" href="/b/demo-business">Try a demo scan</a>
              </div>
            </div>
            <div class="hero-actions__part">
              <p class="hero-actions__label">Running a business?</p>
              <div class="hero-actions__buttons">
                <a class="btn btn--primary" href={toolkitZip}>Download the toolkit</a>
                <a class="btn btn--ghost" href="#for-businesses">Or let us set it up</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- For businesses, with how it works -->
    <section class="section" id="for-businesses">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">For businesses</span>
          <h2>Get your business agent-ready.</h2>
          <p>No website or developer needed. Keep your own checkout.</p>
        </div>
        <article class="setup">
          <div>
            <h3>We set it up for you</h3>
            <p>We bring in your products and prices, get you listed, and send your sticker.</p>
          </div>
          <a class="btn btn--primary" href="#waitlist">Join the waitlist</a>
        </article>

        <div class="how" id="how-it-works">
          <h3 class="how__title">How it works, in three steps</h3>
          <ol class="steps">
            {steps.map((s, i) => (
              <li>
                <span class="steps__n" aria-hidden="true">{i + 1}</span>
                <h4>{s.title}</h4>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
          <p class="detail">
            <a href="/how-it-works">See how it works in detail</a>
            <a href="/businesses">More for businesses</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Shoppers -->
    <section class="section section--teal" id="shoppers">
      <div class="container">
        <div class="shop">
        <div class="shop__chat"><ChatMock /></div>
        <div class="shop__copy">
          <span class="eyebrow">For shoppers</span>
          <h2>Just ask your agent.</h2>
          <p>
            Ask for what you need in plain English. Your agent checks real stock, prices and opening times, then asks
            you before it books or buys.
          </p>
          <ul class="asks">{asks.map((a) => <li><q>{a}</q></li>)}</ul>
          <div class="shop__buttons">
            <button class="btn btn--primary" type="button" data-approval="approve-network" data-app="Claude">Add to Claude</button>
            <button class="btn btn--primary" type="button" data-approval="approve-network" data-app="ChatGPT">Add to ChatGPT</button>
          </div>
          <div class="shop__noagent">
            <p>No agent yet? Chat with us instead:</p>
            <div class="shop__buttons">
              <button class="btn btn--ghost" type="button" data-concept="open the Gentifi assistant in Telegram">Telegram</button>
              <button class="btn btn--ghost" type="button" data-concept="open the Gentifi assistant in WhatsApp">WhatsApp</button>
            </div>
          </div>
          <p class="shop__note">Gentifi isn't live yet, so these buttons show a preview.</p>
        </div>
        </div>
      </div>
    </section>

    <!-- Control -->
    <section class="section" id="privacy">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Privacy</span>
          <h2>Customers are always in control.</h2>
        </div>
        <ul class="control">
          {control.map((c) => <li><Tick size={22} tick="var(--white)" /><span>{c}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- Open by design -->
    <section class="section section--teal" id="open">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Open by design</span>
          <h2>Open source. Open standards. No lock-in.</h2>
          <p>Anyone can use, check and improve what we build. Your business stays yours, in formats any agent can read.</p>
        </div>
        <div class="open">
          <article class="open__card">
            <h3>Open-source toolkit</h3>
            <p>Everything needed to make a business agent-ready. Anyone can use and improve it, under the Apache 2.0 licence.</p>
            <div class="open__links">
              <a href="/toolkit">See the toolkit</a>
              <a href={githubUrl}>GitHub</a>
            </div>
          </article>
          <article class="open__card">
            <h3>Built on open standards</h3>
            <p>We use standards that Claude, ChatGPT and other agents already understand, so you're never tied to one company.</p>
            <p class="open__chips" aria-label="Standards used">MCP · Agent Skills · A2A · ai-catalog.json</p>
            <div class="open__links"><a href="/standards">Our standards</a></div>
          </article>
          <article class="open__card open__card--key">
            <h3>Adding what's missing</h3>
            <p>Today's standards describe one business at a time. We're drafting Collections: an open way to describe a whole market, high street or trade show.</p>
            <div class="open__links"><a href="/standards#draft">Read the draft</a></div>
          </article>
        </div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section waitlist" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Waitlist</span>
          <h2>Be one of the first agent-ready businesses.</h2>
          <p>We're starting with a small group of local businesses. Join the list and we'll be in touch.</p>
          <p class="waitlist__count"><span class="placeholder">[WAITLIST COUNT]</span> already signed up</p>
        </div>
        <WaitlistForm tone="light" />
      </div>
    </section>
  </main>
  <Footer />

  <ConceptNotice />
  <ApprovalDialog
    id="approve-network"
    name="Gentifi"
    initials="G"
    via="Network connector · gentifi.com/mcp"
    abilities={[
      'Search businesses on the Gentifi network',
      'Check live prices, stock and availability',
      'Prepare bookings and orders for you to confirm',
    ]}
  />
</Base>

<style>
  /* Hero: sticker front and centre */
  .hero { padding-block: clamp(48px, 8vw, 88px) clamp(56px, 9vw, 104px); }
  .hero__inner { display: grid; justify-items: center; gap: clamp(32px, 5vw, 48px); text-align: center; }
  .hero__head { display: grid; justify-items: center; }
  .hero__title { font-size: clamp(2.5rem, 8.5vw, 5.4rem); letter-spacing: -0.035em; line-height: 1.02; }
  .hero__nowrap { display: inline-flex; align-items: center; gap: 0.18em; white-space: nowrap; }
  .hero__lede { margin-top: 20px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 38rem; }

  .hero__row { width: 100%; max-width: 960px; display: grid; gap: 28px; justify-items: center; align-items: start; }
  @media (min-width: 900px) { .hero__row { grid-template-columns: repeat(2, minmax(0, 460px)); justify-content: center; gap: 40px; } }
  .hero__sticker { margin: 0; width: min(100%, 460px); display: grid; gap: 14px; }
  .hero__sticker figcaption { font-size: 0.88rem; color: var(--on-teal-muted); }

  /* The sticker and the action panel share one card style */
  .hero__sticker :global(.sticker), .hero-actions {
    background: var(--teal);
    border: 1px solid var(--teal-line);
    box-shadow: 0 28px 60px -20px rgb(0 0 0 / 0.45);
  }
  .hero__sticker :global(.sticker) { text-align: left; }
  .hero-actions {
    width: min(100%, 460px);
    border-radius: 40px;
    padding: 0 32px;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  @media (min-width: 900px) { .hero-actions { aspect-ratio: 1; } }
  .hero-actions__part { padding-block: 28px; display: grid; gap: 14px; min-width: 0; }
  .hero-actions__part + .hero-actions__part { border-top: 1px solid var(--teal-line); }
  .hero-actions__label { font-size: 1.2rem; font-weight: 700; }
  .hero-actions__buttons { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-actions .btn { padding: 10px 18px; font-size: 0.95rem; }
  .hero-actions__text { color: var(--on-teal-muted); font-size: 0.98rem; line-height: 1.5; margin-top: -4px; }
  @media (max-width: 480px) { .hero-actions { padding: 0 24px; border-radius: 32px; } .hero-actions__part { padding-block: 24px; } }

  /* For businesses: setup box, then the steps */
  .setup {
    display: grid;
    gap: 20px;
    align-items: center;
    background: var(--teal);
    color: var(--white);
    border-radius: var(--radius);
    padding: 28px;
  }
  @media (min-width: 760px) { .setup { grid-template-columns: 1fr auto; gap: 40px; padding: 32px 36px; } }
  .setup h3 { font-size: 1.35rem; margin-bottom: 6px; }
  .setup p { color: var(--on-teal-muted); }
  .setup .btn { justify-self: start; }

  .how { margin-top: clamp(48px, 7vw, 72px); scroll-margin-top: 24px; }
  .how__title { font-size: 1.4rem; margin-bottom: 24px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 800px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .steps li { display: grid; gap: 10px; align-content: start; }
  .steps__n {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--teal); color: var(--copper);
    display: grid; place-items: center;
    font-weight: 700; font-size: 1.1rem;
  }
  .steps h4 { font-size: 1.2rem; margin: 4px 0 0; letter-spacing: -0.01em; }
  .steps p { color: var(--ink-muted); }
  .detail { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .detail a { font-weight: 600; color: var(--teal); }

  /* Open by design */
  .open { display: grid; gap: 20px; }
  @media (min-width: 900px) { .open { grid-template-columns: repeat(3, 1fr); } }
  .open__card {
    border: 1px solid var(--teal-line);
    background: var(--teal-raised);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .open__card h3 { font-size: 1.25rem; }
  .open__card > p { color: var(--on-teal-muted); }
  .open__chips { font-family: var(--font-mono); font-size: 0.82rem; color: var(--white) !important; }
  .open__card--key { border: 2px solid var(--copper); }
  .open__links { margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; gap: 18px; }
  .open__links a { color: var(--copper); font-weight: 600; }

  /* Shoppers */
  .shop { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .shop { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .shop__chat { width: 100%; max-width: 460px; justify-self: center; }
  .shop__copy { display: grid; gap: 16px; justify-items: start; }
  .shop__copy .eyebrow { margin-bottom: 0; }
  .shop__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .asks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .asks li { background: var(--teal-raised); border: 1px solid var(--teal-line); color: var(--white); border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 0.95rem; }
  .shop__buttons { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .shop__noagent { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--teal-line); width: 100%; }
  .shop__noagent p { font-weight: 600; }
  .shop__note { font-size: 0.85rem; color: var(--on-teal-muted); }

  /* Control */
  .control { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) { .control { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .control li {
    display: flex; gap: 12px; align-items: flex-start;
    background: var(--grey); border-radius: var(--radius);
    padding: 22px; font-size: 1.05rem; font-weight: 600; line-height: 1.45; color: var(--ink);
  }
  .control li :global(svg) { margin-top: 2px; flex-shrink: 0; }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }
  .waitlist__count { font-size: 0.95rem; color: var(--ink-muted); }
</style>
