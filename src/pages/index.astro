---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WindowSticker from '../components/WindowSticker.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import ChatMock from '../components/ChatMock.astro';
import CollectionDiagram from '../components/CollectionDiagram.astro';
import Tick from '../components/Tick.astro';

const githubUrl = 'https://github.com/SelfBankt/gentifi-toolkit';

const shopSteps = [
  { title: 'Send us your price list', body: 'A spreadsheet is fine. You keep updating it there, and AI sees the changes.' },
  { title: 'Put up your sign', body: 'A counter card by the till and a sticker in the window, each with your own code.' },
  { title: 'Orders come to you', body: 'Customers confirm every order, and it reaches you by email or through your own checkout, as now.' },
];

const customerSteps = [
  { title: 'Scan your sign', body: 'Or tap your link on your website or social pages.' },
  { title: 'Add your shop to their AI', body: 'It takes a minute in Claude or ChatGPT, and they approve it in their own app.' },
  { title: 'Just ask', body: '“Have you got sourdough on Saturday? Save me a loaf.” Nothing is ordered until they confirm.' },
];

const needs = [
  'Your products or services (a spreadsheet is fine)',
  'Prices, and stock if you keep it',
  'Your opening hours',
  'How you take orders today: phone, email, website or booking system',
];

const asks = [
  'Order a birthday cake from a local bakery for Saturday.',
  'Find a bike shop that can service my bike this week.',
  'Book a table for four on Friday at 7.',
];

const mission = [
  { title: 'From the list you already keep', body: 'Products, prices, services and opening hours, from a spreadsheet.' },
  { title: 'Your own checkout and bookings', body: 'Orders, bookings and quote requests go to you, the way they do now.' },
  { title: 'Whole streets and markets at once', body: 'One connection for every trader on a high street, at a market or at a show.' },
];

const control = [
  'Customers approve every connection, in their own app.',
  'Their AI asks before every booking or order.',
  'Businesses only get their details when they choose to book or buy.',
];
---
<Base
  title="Gentifi: your shop, in your customers’ AI"
  description="Customers scan your sign to add your shop to their AI assistant, then ask what you have, check opening times and reserve or order, confirming every order themselves. Live in Claude and ChatGPT today, starting with independents in Bristol and South Gloucestershire."
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">For independent shops, cafés and makers</span>
          <h1 class="hero__title">Your shop, in your customers’ AI.</h1>
          <p class="hero__lede">
            Customers scan your sign once to add you to their AI assistant. Then they can ask what you have and when
            you’re open, and reserve or order. They confirm every order, and it comes to you the way orders do now.
          </p>
          <p class="hero__open"><Tick size={18} tick="var(--teal)" />Live in Claude and ChatGPT today, starting in Bristol and South Gloucestershire</p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="#waitlist">Join the waitlist</a>
            <a class="btn btn--ghost" href="/b/demo-business">Try the live demo</a>
          </div>
          <ul class="hero__alt" aria-label="Find your way">
            <li><a href="#shoppers">Shopping? See how to ask your AI</a></li>
            <li><a href="#events">Running a market, show or high street?</a></li>
            <li><a href="/toolkit">Developer? Get the toolkit</a></li>
            <li><a href="/farm-shops">Farm shop? See what we’re building</a></li>
          </ul>
        </div>

        <figure class="hero__sticker">
          <a href="/b/demo-business" class="hero__sticker-link" aria-label="Open the demo business page">
            <WindowSticker />
          </a>
          <figcaption>Scan it with your phone, or tap it, to open our demo shop.</figcaption>
        </figure>
      </div>
    </section>

    <!-- How it works: for the shop and for its customers -->
    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2>Answer every call.</h2>
          <p>Simple for you, and simple for your customers. No website or developer needed, and nothing changes about your till, your checkout or how you take payment.</p>
        </div>
        <div class="sides">
          <article class="side">
            <h3>For your shop</h3>
            <ol>{shopSteps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
          </article>
          <article class="side side--customer">
            <h3>For your customers</h3>
            <ol>{customerSteps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
          </article>
        </div>

        <article class="setup">
          <div>
            <h3>We set it up for you</h3>
            <p>We bring in your products and prices, host your shop’s page and connection, and send your signs. All we need:</p>
            <ul class="setup__needs">
              {needs.map((n) => <li><Tick size={18} tick="var(--teal)" /><span>{n}</span></li>)}
            </ul>
          </div>
          <div class="setup__actions">
            <a class="btn btn--primary" href="#waitlist">Join the waitlist</a>
            <a class="setup__link" href="/how-it-works">How it works, in detail</a>
          </div>
        </article>
      </div>
    </section>

    <!-- Mission: independents first -->
    <section class="section mission-band" id="independents">
      <div class="container mission">
        <div class="mission__copy">
          <span class="eyebrow">Our mission: independents first</span>
          <h2>Bringing independents into the conversation.</h2>
          <p>When someone asks an AI assistant where to buy, book or eat, the big chains already have their data ready. The independent bakery, bike shop, farm shop or maker down the road usually doesn’t, so the AI can’t see them.</p>
          <p>We’re starting with independent businesses in Bristol and South Gloucestershire, and the markets, shows and high streets that bring them together. Breaking bread.</p>
          <a class="btn btn--teal" href="/businesses">For independent businesses</a>
        </div>
        <ul class="mission__points">
          {mission.map((m) => <li><Tick size={22} tick="var(--white)" /><div><h3>{m.title}</h3><p>{m.body}</p></div></li>)}
        </ul>
      </div>
    </section>

    <!-- Shoppers -->
    <section class="section section--teal" id="shoppers">
      <div class="container">
        <div class="shop">
        <div class="shop__chat"><ChatMock /></div>
        <div class="shop__copy">
          <span class="eyebrow">For shoppers</span>
          <h2>Just ask your AI.</h2>
          <p>
            Add your favourite local shops to your AI assistant. Then ask in plain English: it checks their real
            products, prices and opening times, and asks you before it reserves or buys.
          </p>
          <ul class="asks">{asks.map((a) => <li><q>{a}</q></li>)}</ul>
          <div class="try">
            <p class="try__title">Try it now with our demo shop</p>
            <ol>
              <li>Copy this link: <code>https://mcp.gentifi.com/b/demo-business/mcp</code></li>
              <li>Paste it into your AI app:
                <ul>
                  <li><strong>Claude:</strong> Settings → Connectors → Add custom connector.</li>
                  <li><strong>ChatGPT:</strong> In a browser, not the app: <a href="https://chatgpt.com/plugins">chatgpt.com/plugins</a> → Add (top right) → Add custom MCP server, no authentication. Then type @ in a chat to pick the shop.</li>
                </ul>
              </li>
              <li>Ask: “Does Hollow Lane Farm have eggs? Reserve a dozen for Saturday.” Nothing is ordered: it’s a fictional shop.</li>
            </ol>
            <a class="btn btn--primary" href="/b/demo-business">Open the demo shop</a>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Control -->
    <section class="section" id="privacy">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Privacy</span>
          <h2>Customers are always in control.</h2>
        </div>
        <ul class="control">
          {control.map((c) => <li><Tick size={22} tick="var(--white)" /><span>{c}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- Events, markets and high streets -->
    <section class="section section--teal" id="events">
      <div class="container events">
        <div class="events__copy">
          <span class="eyebrow">Markets, shows and gatherings</span>
          <h2>One connection for a whole market, show or high street.</h2>
          <p>
            Visitors add your market, event or street to their AI once, then ask across every trader or exhibitor:
            <q>Which stalls on Saturday have sourdough? Save me a loaf.</q>
            <q>Which stands sell triple glazing under £600/m²? Get me three quotes.</q>
          </p>
          <ul class="events__points">
            <li><Tick size={20} tick="var(--teal)" /><span>Every member keeps its own data, prices and checkout.</span></li>
            <li><Tick size={20} tick="var(--teal)" /><span>Nobody is listed without agreeing to it.</span></li>
            <li><Tick size={20} tick="var(--teal)" /><span>Exhibitors stay in visitors’ AI after the event.</span></li>
          </ul>
          <p class="events__pilot">We’re piloting this with the first markets and shows.</p>
          <div class="events__ctas">
            <a class="btn btn--primary" href="?role=organiser#waitlist">Put your market, show or street on Gentifi</a>
            <a class="btn btn--ghost" href="/standards">How Business Collections work</a>
          </div>
        </div>
        <div class="events__visual"><CollectionDiagram /></div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section waitlist" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Waitlist</span>
          <h2>Join the Genesis cohort.</h2>
          <p>Our first group of businesses on Gentifi. We're starting with independent businesses in Bristol and South Gloucestershire, and the markets, shows and high streets that bring them together. Join the list and we'll be in touch.</p>
        </div>
        <WaitlistForm tone="light" />
      </div>
    </section>

    <!-- Open by design -->
    <section class="section section--grey open-band" id="open">
      <div class="container open-band__inner">
        <div class="open-band__copy">
          <span class="eyebrow">In one accord</span>
          <h2>Open source. Open standards. No lock-in.</h2>
          <p>One set of open standards, so every AI assistant hears your business in its own language. Anyone can use, check and improve what we build, and your business stays yours.</p>
        </div>
        <ul class="open-band__links">
          <li><a href="/toolkit">The open-source toolkit</a></li>
          <li><a href="/standards">The standards we build on</a></li>
          <li><a href="/standards#draft">The Business Collections draft</a></li>
          <li><a href={githubUrl}>GitHub</a></li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />

</Base>

<style>
  /* Hero: the promise on the left, the sticker as proof on the right */
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(56px, 9vw, 104px); }
  .hero__grid { display: grid; gap: clamp(32px, 5vw, 56px); align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.15fr minmax(0, 0.85fr); } }
  .hero__copy { min-width: 0; }
  .hero__title { font-size: clamp(2.4rem, 6.4vw, 4.4rem); letter-spacing: -0.035em; line-height: 1.02; max-width: 12em; }
  .hero__lede { margin-top: 22px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 36rem; }
  .hero__open { margin-top: 16px; display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 600; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__alt { list-style: none; margin: 28px 0 0; padding: 18px 0 0; border-top: 1px solid var(--teal-line); display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.92rem; }
  .hero__alt a { color: var(--white); text-decoration-color: var(--teal-line); }
  .hero__alt a:hover { text-decoration-color: var(--copper); }
  .hero__alt a::after { content: ' \2192'; color: var(--copper); }

  .hero__sticker { margin: 0; width: min(100%, 440px); justify-self: center; display: grid; gap: 14px; }
  .hero__sticker-link { display: block; border-radius: 40px; text-decoration: none; transition: transform 0.2s; }
  .hero__sticker-link:hover { transform: rotate(-1deg) translateY(-2px); }
  .hero__sticker :global(.sticker) { box-shadow: 0 28px 60px -20px rgb(0 0 0 / 0.45); }
  .hero__sticker figcaption { font-size: 0.88rem; color: var(--on-teal-muted); text-align: center; }
  @media (max-width: 959px) { .hero__sticker { width: min(100%, 360px); } }
  @media (prefers-reduced-motion: reduce) { .hero__sticker-link, .hero__sticker-link:hover { transition: none; transform: none; } }

  /* Mission: independents first */
  .mission-band { background: var(--grey); }
  .mission { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .mission { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  .mission__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .mission__copy .eyebrow { margin-bottom: 0; }
  .mission__copy > p { color: var(--ink-muted); font-size: 1.08rem; max-width: 36rem; }
  .mission__copy .btn { margin-top: 8px; }
  .mission__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .mission__points li { display: flex; gap: 14px; align-items: flex-start; background: var(--white); border-radius: var(--radius); padding: 20px 22px; }
  .mission__points li :global(svg) { margin-top: 2px; flex-shrink: 0; }
  .mission__points h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .mission__points p { color: var(--ink-muted); }

  /* How it works: the shop and its customers, side by side */
  .sides { display: grid; gap: 20px; }
  @media (min-width: 860px) { .sides { grid-template-columns: 1fr 1fr; } }
  .side { background: var(--grey); border-radius: var(--radius); padding: 28px; display: grid; gap: 18px; align-content: start; }
  .side--customer { background: var(--teal); color: var(--white); }
  .side h3 { font-size: 1.3rem; }
  .side ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: step; }
  .side li { counter-increment: step; display: grid; grid-template-columns: 36px 1fr; gap: 2px 12px; }
  .side li::before { content: counter(step); grid-row: span 2; width: 32px; height: 32px; border-radius: 50%; background: var(--teal); color: var(--copper); display: grid; place-items: center; font-weight: 700; }
  .side--customer li::before { background: var(--copper); color: var(--teal); }
  .side li span { color: var(--ink-muted); }
  .side--customer li span { color: var(--on-teal-muted); }

  /* We set it up */
  .setup {
    margin-top: clamp(40px, 6vw, 56px);
    display: grid;
    gap: 24px;
    align-items: center;
    background: var(--teal);
    color: var(--white);
    border-radius: var(--radius);
    padding: 28px;
  }
  @media (min-width: 860px) { .setup { grid-template-columns: 1fr auto; gap: 48px; padding: 36px 40px; } }
  .setup h3 { font-size: 1.35rem; margin-bottom: 6px; }
  .setup p { color: var(--on-teal-muted); }
  .setup__needs { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; }
  @media (min-width: 640px) { .setup__needs { grid-template-columns: 1fr 1fr; column-gap: 24px; } }
  .setup__needs li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.95rem; }
  .setup__needs li :global(svg) { margin-top: 3px; }
  .setup__actions { display: grid; gap: 14px; justify-items: start; }
  @media (min-width: 860px) { .setup__actions { justify-items: center; } }
  .setup__link { color: var(--white); font-weight: 600; font-size: 0.95rem; }

  /* Shoppers */
  .shop { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .shop { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .shop__chat { width: 100%; max-width: 460px; justify-self: center; }
  .shop__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .shop__copy .eyebrow { margin-bottom: 0; }
  .shop__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .asks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .asks li { background: var(--teal-raised); border: 1px solid var(--teal-line); color: var(--white); border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 0.95rem; }
  .try { width: 100%; background: var(--teal-raised); border: 1px solid var(--teal-line); border-radius: var(--radius); padding: 20px 22px; display: grid; gap: 12px; justify-items: start; }
  .try__title { font-weight: 700; }
  .try ol { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; color: var(--on-teal-muted); }
  .try li::marker { color: var(--copper); font-weight: 700; }
  .try code { color: var(--white); overflow-wrap: anywhere; font-size: 0.88rem; }
  .try ul { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; }
  .try strong, .try a { color: var(--white); }

  /* Control */
  .control { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) { .control { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .control li {
    display: flex; gap: 12px; align-items: flex-start;
    background: var(--grey); border-radius: var(--radius);
    padding: 22px; font-size: 1.05rem; font-weight: 600; line-height: 1.45; color: var(--ink);
  }
  .control li :global(svg) { margin-top: 2px; flex-shrink: 0; }

  /* Events, markets and high streets */
  .events { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .events { grid-template-columns: 1.05fr 1fr; gap: 64px; } }
  .events__copy { display: grid; gap: 18px; justify-items: start; min-width: 0; }
  .events__copy .eyebrow { margin-bottom: 0; }
  .events__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .events__copy q { display: block; margin-top: 10px; color: var(--white); font-weight: 600; }
  .events__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .events__points li { display: flex; gap: 10px; align-items: flex-start; }
  .events__points li :global(svg) { margin-top: 3px; }
  .events__pilot { color: var(--on-teal-muted); font-size: 0.95rem; }
  .events__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .events__visual { width: 100%; max-width: 480px; justify-self: center; }

  /* Open by design */
  .open-band__inner { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) { .open-band__inner { grid-template-columns: 1.4fr 1fr; gap: 56px; } }
  .open-band__copy { display: grid; gap: 14px; }
  .open-band__copy .eyebrow { margin-bottom: 0; }
  .open-band__copy p { color: var(--ink-muted); max-width: 40rem; }
  .open-band__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .open-band__links a { color: var(--teal); font-weight: 600; }
  .open-band__links a::after { content: ' \2192'; color: var(--copper); }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }
</style>
