---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WindowSticker from '../components/WindowSticker.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import ChatMock from '../components/ChatMock.astro';
import ApprovalDialog from '../components/ApprovalDialog.astro';
import ConceptNotice from '../components/ConceptNotice.astro';
import CollectionDiagram from '../components/CollectionDiagram.astro';
import QrCode from '../components/QrCode.astro';
import Mark from '../components/Mark.astro';
import Tick from '../components/Tick.astro';

const githubUrl = 'https://github.com/SelfBankt/gentifi-toolkit';

const steps = [
  { title: 'Send us your products', body: 'A spreadsheet is fine. We turn your products, prices, stock and services into something AI agents can read and act on.' },
  { title: 'Put up your sign', body: 'Customers scan it, approve the handshake in their own app, and your business is in the agent they already use.' },
  { title: 'Customers just ask', body: 'Their agent checks your stock, prices and times, then books or orders once they say yes.' },
];

const needs = [
  'Your products or services (a spreadsheet is fine)',
  'Prices, and stock if you keep it',
  'Your opening hours',
  'How you take orders today: phone, email, website or booking system',
];

const asks = [
  'Which farm near me has eggs this week?',
  'Reserve a veg box for Saturday collection.',
  'Find a plumber available on Tuesday.',
];

const mission = [
  { title: 'What’s in today', body: 'Stock marked in or sold out from a phone, with the time it was checked.' },
  { title: 'Pre-orders for collection', body: 'Veg boxes, bread and Christmas orders, confirmed by the customer.' },
  { title: 'Whole markets at once', body: 'One connection for every stall at a farmers’ market or food festival.' },
];

const control = [
  'Customers approve every connection, in their own app.',
  'Their agent asks before every booking or order.',
  'Businesses only get their details when they choose to book or buy.',
];
---
<Base
  title="Gentifi: agent-ready business"
  description="Gentifi makes local businesses findable, bookable and buyable through AI agents like Claude and ChatGPT, starting with farm shops and local food in Bristol and South Gloucestershire. Customers approve every step. Open source and built on open standards."
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">Claude · ChatGPT · Hermes · any agent</span>
          <h1 class="hero__title">Open for business in every AI agent.</h1>
          <p class="hero__lede">
            When people ask their AI agent for something local, Gentifi lets it find your products, check your prices
            and stock, and book or order, with the customer approving every step.
          </p>
          <p class="hero__open"><Tick size={18} tick="var(--teal)" />Open source and built on open standards</p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="#waitlist">Get your business agent-ready</a>
            <a class="btn btn--ghost" href="/b/demo-business">Try a demo scan</a>
          </div>
          <ul class="hero__alt" aria-label="Find your way">
            <li><a href="/farm-shops">Farm shop, farm or market? Start here</a></li>
            <li><a href="#shoppers">Shopping? See what your agent can do</a></li>
            <li><a href="#events">Running a show, market or high street?</a></li>
            <li><a href="/toolkit">Developer? Get the toolkit</a></li>
          </ul>
        </div>

        <figure class="hero__sticker">
          <a href="/b/demo-business" class="hero__sticker-link" aria-label="Open the demo business page">
            <WindowSticker />
          </a>
          <figcaption>Scan the code with your phone, or tap it: it opens a demo business.</figcaption>
        </figure>
      </div>
    </section>

    <!-- First mission: local food -->
    <section class="section mission-band" id="local-food">
      <div class="container mission">
        <div class="mission__copy">
          <span class="eyebrow">Our first mission: a local food revival</span>
          <h2>Local food, found by AI.</h2>
          <p>A farm shop’s stock changes every day: the eggs sell out, the bread comes out at twelve, the Christmas orders open. Most of that never reaches a website, so AI agents can’t see it.</p>
          <p>We’re starting with farm shops, local farms and farmers’ markets in Bristol and South Gloucestershire, so the farm down the road is as easy for an agent to find as the supermarket.</p>
          <a class="btn btn--teal" href="/farm-shops">For farm shops and markets</a>
        </div>
        <ul class="mission__points">
          {mission.map((m) => <li><Tick size={22} tick="var(--white)" /><div><h3>{m.title}</h3><p>{m.body}</p></div></li>)}
        </ul>
      </div>
    </section>

    <!-- For businesses, with how it works -->
    <section class="section" id="for-businesses">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">For businesses</span>
          <h2>Answer every call.</h2>
          <p>When a customer’s agent asks about your stock, prices or opening times, Gentifi answers for you. No website or developer needed, and you keep your own checkout.</p>
        </div>

        <ol class="strip" id="how-it-works">
          <li class="strip__step">
            <div class="strip__visual" aria-hidden="true">
              <div class="mini-sheet">
                <div class="mini-sheet__row mini-sheet__row--head"><span>Item</span><span>Price</span><span>Stock</span></div>
                <div class="mini-sheet__row"><span>Free-range eggs</span><span>£3.20</span><span>40</span></div>
                <div class="mini-sheet__row"><span>Sourdough loaf</span><span>£4.50</span><span>12</span></div>
                <div class="mini-sheet__row"><span>Veg box</span><span>£18.00</span><span>15</span></div>
              </div>
            </div>
            <span class="strip__n">1</span>
            <h3>{steps[0].title}</h3>
            <p>{steps[0].body}</p>
          </li>
          <li class="strip__step">
            <div class="strip__visual" aria-hidden="true">
              <div class="mini-sticker">
                <div class="mini-sticker__brand"><Mark size={26} /><span>Gentifi</span><Tick size={14} tick="var(--teal)" /></div>
                <div class="mini-sticker__bottom">
                  <p>Scan to add us to your AI agent</p>
                  <div class="mini-sticker__qr"><QrCode label="" /></div>
                </div>
              </div>
            </div>
            <span class="strip__n">2</span>
            <h3>{steps[1].title}</h3>
            <p>{steps[1].body}</p>
          </li>
          <li class="strip__step">
            <div class="strip__visual" aria-hidden="true">
              <div class="mini-chat">
                <p class="mini-chat__you">Reserve a dozen eggs for Saturday?</p>
                <p class="mini-chat__agent">1 x Free-range eggs, £3.20. Collect Saturday.</p>
                <span class="mini-chat__confirm">Confirm reservation</span>
              </div>
            </div>
            <span class="strip__n">3</span>
            <h3>{steps[2].title}</h3>
            <p>{steps[2].body}</p>
          </li>
        </ol>

        <article class="setup">
          <div>
            <h3>We set it up for you</h3>
            <p>We bring in your products and prices, get you on the Gentifi network, and send your signs. All we need:</p>
            <ul class="setup__needs">
              {needs.map((n) => <li><Tick size={18} tick="var(--teal)" /><span>{n}</span></li>)}
            </ul>
          </div>
          <div class="setup__actions">
            <a class="btn btn--primary" href="#waitlist">Join the waitlist</a>
            <a class="setup__link" href="/how-it-works">How it works, in detail</a>
          </div>
        </article>
      </div>
    </section>

    <!-- Shoppers -->
    <section class="section section--teal" id="shoppers">
      <div class="container">
        <div class="shop">
        <div class="shop__chat"><ChatMock /></div>
        <div class="shop__copy">
          <span class="eyebrow">For shoppers</span>
          <h2>Just ask your agent.</h2>
          <p>
            Ask for what you need in plain English. Your agent checks real stock, prices and opening times, then asks
            you before it books or buys.
          </p>
          <ul class="asks">{asks.map((a) => <li><q>{a}</q></li>)}</ul>
          <div class="shop__buttons">
            <button class="btn btn--primary" type="button" data-approval="approve-network" data-app="Claude">Add to Claude</button>
            <button class="btn btn--primary" type="button" data-approval="approve-network" data-app="ChatGPT">Add to ChatGPT</button>
          </div>
          <div class="shop__noagent">
            <p>No agent yet? Chat with our AI instead:</p>
            <div class="shop__buttons">
              <button class="btn btn--ghost" type="button" data-concept="open Gentifi's AI assistant in WhatsApp">WhatsApp</button>
              <button class="btn btn--ghost" type="button" data-concept="open Gentifi's AI assistant in Telegram">Telegram</button>
            </div>
          </div>
          <p class="shop__note">Gentifi isn't live yet, so these buttons show a preview.</p>
        </div>
        </div>
      </div>
    </section>

    <!-- Control -->
    <section class="section" id="privacy">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Privacy</span>
          <h2>Nothing happens until they touch and agree.</h2>
        </div>
        <ul class="control">
          {control.map((c) => <li><Tick size={22} tick="var(--white)" /><span>{c}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- Events, markets and high streets -->
    <section class="section section--teal" id="events">
      <div class="container events">
        <div class="events__copy">
          <span class="eyebrow">Markets, shows and gatherings</span>
          <h2>One connection for a whole farmers’ market, show or high street.</h2>
          <p>
            Visitors add your market, event or street to their agent once, then ask across every trader or exhibitor:
            <q>Which stalls on Saturday have sourdough? Save me a loaf.</q>
            <q>Which stands sell triple glazing under £600/m²? Get me three quotes.</q>
          </p>
          <ul class="events__points">
            <li><Tick size={20} tick="var(--teal)" /><span>Every member keeps its own data, prices and checkout.</span></li>
            <li><Tick size={20} tick="var(--teal)" /><span>Nobody is listed without agreeing to it.</span></li>
            <li><Tick size={20} tick="var(--teal)" /><span>Exhibitors stay in visitors' agents after the event.</span></li>
          </ul>
          <div class="events__ctas">
            <a class="btn btn--primary" href="?role=organiser#waitlist">Put your market, show or street on Gentifi</a>
            <a class="btn btn--ghost" href="/standards">How Business Collections work</a>
          </div>
        </div>
        <div class="events__visual"><CollectionDiagram /></div>
      </div>
    </section>

    <!-- Open by design -->
    <section class="section section--grey" id="open">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">In one accord</span>
          <h2>Open source. Open standards. No lock-in.</h2>
          <p>One set of open standards, so every agent hears your business in its own language. Anyone can use, check and improve what we build, and your business stays yours.</p>
        </div>
        <div class="open">
          <article class="open__card">
            <h3>Open-source toolkit</h3>
            <p>Turns a product list into everything agents need, and tests it like an agent would. Anyone can use and improve it, under the Apache 2.0 licence.</p>
            <div class="open__links">
              <a href="/toolkit">See the toolkit</a>
              <a href={githubUrl}>GitHub</a>
            </div>
          </article>
          <article class="open__card">
            <h3>Built on open standards</h3>
            <p>We use the standards Claude, ChatGPT and other agents already understand, so you're never tied to one company.</p>
            <div class="open__links"><a href="/standards">Our standards</a></div>
          </article>
          <article class="open__card open__card--key">
            <h3>Adding what's missing</h3>
            <p>Today's standards describe one business at a time. We're drafting Business Collections: an open way to describe a whole market, high street or trade show.</p>
            <div class="open__links"><a href="/standards#draft">Read the draft</a></div>
          </article>
        </div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section waitlist" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Waitlist</span>
          <h2>Join the Genesis cohort.</h2>
          <p>Our first group of agent-ready businesses. We're starting with farm shops, local farms and farmers' markets in Bristol and South Gloucestershire, then other local businesses and events. Join the list and we'll be in touch.</p>
          <p class="waitlist__count"><span class="placeholder">[WAITLIST COUNT]</span> already signed up</p>
        </div>
        <WaitlistForm tone="light" />
      </div>
    </section>
  </main>
  <Footer />

  <ConceptNotice />
  <ApprovalDialog
    id="approve-network"
    name="Gentifi"
    initials="G"
    via="Network connector · gentifi.com/mcp"
    abilities={[
      'Search businesses on the Gentifi network',
      'Check live prices, stock and availability',
      'Prepare bookings and orders for you to confirm',
    ]}
  />
</Base>

<style>
  /* Hero: the promise on the left, the sticker as proof on the right */
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(56px, 9vw, 104px); }
  .hero__grid { display: grid; gap: clamp(32px, 5vw, 56px); align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.15fr minmax(0, 0.85fr); } }
  .hero__copy { min-width: 0; }
  .hero__title { font-size: clamp(2.4rem, 6.4vw, 4.4rem); letter-spacing: -0.035em; line-height: 1.02; max-width: 12em; }
  .hero__lede { margin-top: 22px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 36rem; }
  .hero__open { margin-top: 16px; display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 600; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__alt { list-style: none; margin: 28px 0 0; padding: 18px 0 0; border-top: 1px solid var(--teal-line); display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.92rem; }
  .hero__alt a { color: var(--white); text-decoration-color: var(--teal-line); }
  .hero__alt a:hover { text-decoration-color: var(--copper); }
  .hero__alt a::after { content: ' \2192'; color: var(--copper); }

  .hero__sticker { margin: 0; width: min(100%, 440px); justify-self: center; display: grid; gap: 14px; }
  .hero__sticker-link { display: block; border-radius: 40px; text-decoration: none; transition: transform 0.2s; }
  .hero__sticker-link:hover { transform: rotate(-1deg) translateY(-2px); }
  .hero__sticker :global(.sticker) { box-shadow: 0 28px 60px -20px rgb(0 0 0 / 0.45); }
  .hero__sticker figcaption { font-size: 0.88rem; color: var(--on-teal-muted); text-align: center; }
  @media (max-width: 959px) { .hero__sticker { width: min(100%, 360px); } }
  @media (prefers-reduced-motion: reduce) { .hero__sticker-link, .hero__sticker-link:hover { transition: none; transform: none; } }

  /* First mission: local food */
  .mission-band { background: var(--grey); }
  .mission { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .mission { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  .mission__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .mission__copy .eyebrow { margin-bottom: 0; }
  .mission__copy > p { color: var(--ink-muted); font-size: 1.08rem; max-width: 36rem; }
  .mission__copy .btn { margin-top: 8px; }
  .mission__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .mission__points li { display: flex; gap: 14px; align-items: flex-start; background: var(--white); border-radius: var(--radius); padding: 20px 22px; }
  .mission__points li :global(svg) { margin-top: 2px; flex-shrink: 0; }
  .mission__points h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .mission__points p { color: var(--ink-muted); }

  /* How it works: three steps, each with a small picture of what happens */
  .strip { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  @media (min-width: 860px) { .strip { grid-template-columns: repeat(3, 1fr); gap: 28px; } }
  .strip__step { display: grid; gap: 10px; align-content: start; }
  .strip__visual {
    height: 196px;
    border-radius: var(--radius);
    background: var(--grey);
    display: grid;
    place-items: center;
    padding: 20px;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .strip__n {
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--teal); color: var(--copper);
    display: grid; place-items: center;
    font-weight: 700; font-size: 0.95rem;
  }
  .strip h3 { font-size: 1.2rem; margin-top: 2px; }
  .strip__step > p { color: var(--ink-muted); }

  .mini-sheet { width: 100%; max-width: 280px; background: var(--white); border: 1px solid var(--border); border-radius: 12px; font-size: 0.8rem; overflow: hidden; }
  .mini-sheet__row { display: grid; grid-template-columns: 1.7fr 1fr 0.7fr; gap: 8px; padding: 8px 12px; border-top: 1px solid var(--grey); }
  .mini-sheet__row--head { border-top: 0; background: var(--teal); color: var(--white); font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .mini-sheet__row span:nth-child(2), .mini-sheet__row span:nth-child(3) { font-family: var(--font-mono); }

  .mini-sticker { width: 156px; aspect-ratio: 1; background: var(--teal); color: var(--white); border-radius: 18px; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; transform: rotate(-3deg); box-shadow: 0 14px 30px -14px rgb(0 0 0 / 0.5); }
  .mini-sticker__brand { display: flex; align-items: center; gap: 5px; font-weight: 700; font-size: 0.85rem; }
  .mini-sticker__bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; border-top: 1px solid var(--teal-line); padding-top: 8px; }
  .mini-sticker p { font-size: 0.64rem; font-weight: 600; line-height: 1.25; }
  .mini-sticker__qr { width: 54px; flex-shrink: 0; }
  .mini-sticker__qr :global(.qr) { padding: 6%; border-radius: 8px; }

  .mini-chat { width: 100%; max-width: 280px; display: grid; gap: 8px; font-size: 0.8rem; line-height: 1.4; }
  .mini-chat p { margin: 0; padding: 8px 12px; border-radius: 14px; }
  .mini-chat__you { justify-self: end; background: var(--teal); color: var(--white); border-bottom-right-radius: 4px; }
  .mini-chat__agent { background: var(--white); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
  .mini-chat__confirm { justify-self: start; background: var(--copper); color: var(--teal); font-weight: 700; padding: 6px 12px; border-radius: 999px; }

  /* We set it up */
  .setup {
    margin-top: clamp(40px, 6vw, 56px);
    display: grid;
    gap: 24px;
    align-items: center;
    background: var(--teal);
    color: var(--white);
    border-radius: var(--radius);
    padding: 28px;
  }
  @media (min-width: 860px) { .setup { grid-template-columns: 1fr auto; gap: 48px; padding: 36px 40px; } }
  .setup h3 { font-size: 1.35rem; margin-bottom: 6px; }
  .setup p { color: var(--on-teal-muted); }
  .setup__needs { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 8px; }
  @media (min-width: 640px) { .setup__needs { grid-template-columns: 1fr 1fr; column-gap: 24px; } }
  .setup__needs li { display: flex; gap: 10px; align-items: flex-start; font-size: 0.95rem; }
  .setup__needs li :global(svg) { margin-top: 3px; }
  .setup__actions { display: grid; gap: 14px; justify-items: start; }
  @media (min-width: 860px) { .setup__actions { justify-items: center; } }
  .setup__link { color: var(--white); font-weight: 600; font-size: 0.95rem; }

  /* Shoppers */
  .shop { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .shop { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .shop__chat { width: 100%; max-width: 460px; justify-self: center; }
  .shop__copy { display: grid; gap: 16px; justify-items: start; }
  .shop__copy .eyebrow { margin-bottom: 0; }
  .shop__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .asks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .asks li { background: var(--teal-raised); border: 1px solid var(--teal-line); color: var(--white); border-radius: 999px; padding: 8px 16px; font-weight: 600; font-size: 0.95rem; }
  .shop__buttons { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .shop__noagent { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--teal-line); width: 100%; }
  .shop__noagent p { font-weight: 600; }
  .shop__note { font-size: 0.85rem; color: var(--on-teal-muted); }

  /* Control */
  .control { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) { .control { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .control li {
    display: flex; gap: 12px; align-items: flex-start;
    background: var(--grey); border-radius: var(--radius);
    padding: 22px; font-size: 1.05rem; font-weight: 600; line-height: 1.45; color: var(--ink);
  }
  .control li :global(svg) { margin-top: 2px; flex-shrink: 0; }

  /* Events, markets and high streets */
  .events { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .events { grid-template-columns: 1.05fr 1fr; gap: 64px; } }
  .events__copy { display: grid; gap: 18px; justify-items: start; min-width: 0; }
  .events__copy .eyebrow { margin-bottom: 0; }
  .events__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .events__copy q { display: block; margin-top: 10px; color: var(--white); font-weight: 600; }
  .events__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .events__points li { display: flex; gap: 10px; align-items: flex-start; }
  .events__points li :global(svg) { margin-top: 3px; }
  .events__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .events__visual { width: 100%; max-width: 480px; justify-self: center; }

  /* Open by design */
  .open { display: grid; gap: 20px; }
  @media (min-width: 900px) { .open { grid-template-columns: repeat(3, 1fr); } }
  .open__card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .open__card h3 { font-size: 1.25rem; }
  .open__card > p { color: var(--ink-muted); }
  .open__card--key { box-shadow: inset 0 0 0 2px var(--copper); }
  .open__links { margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; gap: 18px; }
  .open__links a { color: var(--teal); font-weight: 600; }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }
  .waitlist__count { font-size: 0.95rem; color: var(--ink-muted); }
</style>
