---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WindowSticker from '../components/WindowSticker.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import CheckForm from '../components/CheckForm.astro';
import ChatMock from '../components/ChatMock.astro';
import Tick from '../components/Tick.astro';

const shopSteps = [
  { title: 'Send us your price list', body: 'A spreadsheet is fine. You keep updating it there, and AI sees the changes.' },
  { title: 'Put up your sign', body: 'A counter card by the till and a sticker in the window, each with your own code.' },
  { title: 'Orders come to you', body: 'Customers confirm every order, and it reaches you by email or through your own checkout, as now.' },
];


const optimise = [
  { title: 'An AI visibility check', body: 'We check what your website and Google profile tell AI today, and send you a one-page report in plain English.' },
  { title: 'Your website, made AI-readable', body: 'We write the structured data that tells AI you’re a local shop, where you are and when you’re open. You paste it in once, and your site looks the same.' },
  { title: 'Your Google profile, checked', body: 'Name, hours, holiday hours, category and products, so AI answers about you correctly.' },
  { title: 'In Claude and ChatGPT', body: 'Your products, prices and opening times in your customers’ AI assistants, kept up to date from your own list.' },
];

const customerSteps = [
  { title: 'Scan your sign', body: 'Or tap your link on your website or social pages.' },
  { title: 'Add your shop to their AI', body: 'It takes a minute in Claude or ChatGPT, and they approve it in their own app.' },
  { title: 'Just ask', body: '“Have you got sourdough on Saturday? Save me a loaf.” Nothing is ordered until they confirm.' },
];

const control = [
  'Customers approve every connection, in their own app.',
  'Their AI asks before every booking or order.',
  'Businesses only get their details when they choose to book or buy.',
];
---
<Base
  title="Gentifi: your shop, in your customers’ AI"
  description="AI optimisation for independent shops: customers scan your sign to add your shop to their AI assistant, then ask what you have, check opening times and reserve or order, confirming every order themselves. Live in Claude and ChatGPT today, starting with independents in Bristol and South Gloucestershire."
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">AI optimisation for independent shops, businesses and events</span>
          <h1 class="hero__title">Your shop, in your customers’ AI.</h1>
          <p class="hero__lede">
            Customers scan your sign once to add you to their AI assistant. Then they can ask what you have and when
            you’re open, and reserve or order. They confirm every order, and it comes to you the way orders do now.
          </p>
          <p class="hero__open"><Tick size={18} tick="var(--teal)" />Live in Claude and ChatGPT today, starting in Bristol and South Gloucestershire</p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="/join">Sign up your shop</a>
            <a class="btn btn--ghost" href="#ai-optimisation">Get your AI visibility check</a>
          </div>
          <ul class="hero__alt" aria-label="Find your way">
            <li><a href="#shoppers">Shopping? See how to ask your AI</a></li>
            <li><a href="/events">Running a market, show or high street?</a></li>
          </ul>
        </div>

        <figure class="hero__sticker">
          <a href="/b/demo-business" class="hero__sticker-link" aria-label="Open the demo business page">
            <WindowSticker />
          </a>
          <figcaption>Scan it with your phone, or tap it, to open our demo shop.</figcaption>
        </figure>
      </div>
    </section>

    <!-- How it works: for the shop and for its customers -->
    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2>Answer every call.</h2>
          <p>Simple for you, and simple for your customers. No website or developer needed, and nothing changes about your till, your checkout or how you take payment.</p>
        </div>
        <div class="sides">
          <article class="side">
            <h3>For your shop</h3>
            <ol>{shopSteps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
          </article>
          <article class="side side--customer">
            <h3>For your customers</h3>
            <ol>{customerSteps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
          </article>
        </div>

      </div>
    </section>

    <!-- AI optimisation -->
    <section class="section section--grey" id="ai-optimisation">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">AI optimisation, done for you</span>
          <h2>Get found by AI, not just by Google.</h2>
          <p>When customers ask ChatGPT, Claude, Google or Perplexity about local shops, the answer comes from what AI can read about you. We make sure it reads the right things.</p>
        </div>
        <ul class="optimise">
          {optimise.map((o) => <li><h3>{o.title}</h3><p>{o.body}</p></li>)}
        </ul>
        <h3 class="optimise__ask">Ask for your AI visibility check</h3>
        <CheckForm />
        <p class="optimise__or">Ready to go further? <a href="/join">Sign up your shop</a>, or see <a href="/how-it-works">how it works, in detail</a>.</p>
      </div>
    </section>

    <!-- Mission: independents first -->
    <section class="section mission-band" id="independents">
      <div class="container mission">
        <div class="mission__copy">
          <span class="eyebrow">Our mission: independents first</span>
          <h2>Bringing independents into the conversation.</h2>
          <p>When someone asks an AI assistant where to buy, book or eat, the big chains already have their data ready. The independent bakery, bike shop, farm shop or maker down the road usually doesn’t, so the AI can’t see them.</p>
          <p>We’re starting with independent businesses in Bristol and South Gloucestershire, and the markets, shows and high streets that bring them together. Breaking bread.</p>
        </div>
        <div class="control" id="privacy">
          <h3>Customers are always in control.</h3>
          <ul>{control.map((c) => <li><Tick size={20} tick="var(--white)" /><span>{c}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <!-- Shoppers -->
    <section class="section section--teal" id="shoppers">
      <div class="container">
        <div class="shop">
        <div class="shop__chat"><ChatMock /></div>
        <div class="shop__copy">
          <span class="eyebrow">For shoppers</span>
          <h2>Just ask your AI.</h2>
          <p>
            Add your favourite local shops to your AI assistant. Then ask in plain English: it checks their real
            products, prices and opening times, and asks you before it reserves or buys.
          </p>
          <div class="try">
            <p class="try__title">Try it now with our demo shop</p>
            <ol>
              <li>Copy the Gentifi link: <code>https://mcp.gentifi.com/mcp</code></li>
              <li>Paste it into your AI app:
                <ul>
                  <li><strong>Claude:</strong> Settings → Connectors → Add custom connector.</li>
                  <li><strong>ChatGPT:</strong> In a browser, not the app: <a href="https://chatgpt.com/plugins">chatgpt.com/plugins</a> → Add (top right) → Add custom MCP server, no authentication. Then type @ in a chat to pick the shop.</li>
                </ul>
              </li>
              <li>Ask: “Does Hollow Lane Farm have eggs? Reserve a dozen for Saturday.” Nothing is ordered: it’s a fictional shop.</li>
            </ol>
            <a class="btn btn--primary" href="/b/demo-business">Open the demo shop</a>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section waitlist" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Stay in touch</span>
          <h2>Not ready yet? Stay in touch.</h2>
          <p>Leave your name and email, and we’ll keep you posted as Gentifi grows in Bristol and South Gloucestershire, for shops, markets, shows and high streets. Ready now? <a href="/join">Sign up your shop</a> and join the Genesis cohort, our first group of businesses.</p>
        </div>
        <WaitlistForm tone="light" />
      </div>
    </section>

  </main>
  <Footer />

</Base>

<style>
  /* Hero: the promise on the left, the sticker as proof on the right */
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(56px, 9vw, 104px); }
  .hero__grid { display: grid; gap: clamp(32px, 5vw, 56px); align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.15fr minmax(0, 0.85fr); } }
  .hero__copy { min-width: 0; }
  .hero__title { font-size: clamp(2.4rem, 6.4vw, 4.4rem); letter-spacing: -0.035em; line-height: 1.02; max-width: 12em; }
  .hero__lede { margin-top: 22px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 36rem; }
  .hero__open { margin-top: 16px; display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 600; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__alt { list-style: none; margin: 28px 0 0; padding: 18px 0 0; border-top: 1px solid var(--teal-line); display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.92rem; }
  .hero__alt a { color: var(--white); text-decoration-color: var(--teal-line); }
  .hero__alt a:hover { text-decoration-color: var(--copper); }
  .hero__alt a::after { content: ' \2192'; color: var(--copper); }

  .hero__sticker { margin: 0; width: min(100%, 440px); justify-self: center; display: grid; gap: 14px; }
  .hero__sticker-link { display: block; border-radius: 40px; text-decoration: none; transition: transform 0.2s; }
  .hero__sticker-link:hover { transform: rotate(-1deg) translateY(-2px); }
  .hero__sticker :global(.sticker) { box-shadow: 0 28px 60px -20px rgb(0 0 0 / 0.45); }
  .hero__sticker figcaption { font-size: 0.88rem; color: var(--on-teal-muted); text-align: center; }
  @media (max-width: 959px) { .hero__sticker { width: min(100%, 360px); } }
  @media (prefers-reduced-motion: reduce) { .hero__sticker-link, .hero__sticker-link:hover { transition: none; transform: none; } }

  /* Mission: independents first */
  .mission-band { background: var(--white); }
  .mission { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .mission { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  .control { background: var(--grey); border-radius: var(--radius); padding: 26px 28px; display: grid; gap: 14px; }
  .control h3 { font-size: 1.3rem; }
  .control ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .control li { display: flex; gap: 12px; align-items: flex-start; font-weight: 600; color: var(--ink); }
  .control li :global(svg) { margin-top: 2px; flex-shrink: 0; }

  .mission__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .mission__copy .eyebrow { margin-bottom: 0; }
  .mission__copy > p { color: var(--ink-muted); font-size: 1.08rem; max-width: 36rem; }
  /* How it works: the shop and its customers, side by side */
  .sides { display: grid; gap: 20px; }
  @media (min-width: 860px) { .sides { grid-template-columns: 1fr 1fr; } }
  .side { background: var(--grey); border-radius: var(--radius); padding: 28px; display: grid; gap: 18px; align-content: start; }
  .side--customer { background: var(--teal); color: var(--white); }
  .side h3 { font-size: 1.3rem; }
  .side ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: step; }
  .side li { counter-increment: step; display: grid; grid-template-columns: 36px 1fr; gap: 2px 12px; }
  .side li::before { content: counter(step); grid-row: span 2; width: 32px; height: 32px; border-radius: 50%; background: var(--teal); color: var(--copper); display: grid; place-items: center; font-weight: 700; }
  .side--customer li::before { background: var(--copper); color: var(--teal); }
  .side li span { color: var(--ink-muted); }
  .side--customer li span { color: var(--on-teal-muted); }

  /* AI optimisation */
  .optimise { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 720px) { .optimise { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .optimise { grid-template-columns: repeat(4, 1fr); } }
  .optimise li { background: var(--white); border-radius: var(--radius); padding: 22px 24px; display: grid; gap: 8px; align-content: start; border-top: 4px solid var(--copper); }
  .optimise h3 { font-size: 1.1rem; }
  .optimise p { color: var(--ink-muted); font-size: 0.95rem; }
  .optimise__ask { font-size: 1.2rem; margin: 36px 0 14px; }
  .optimise__or { margin-top: 16px; color: var(--ink-muted); }
  .optimise__or a { color: var(--teal); font-weight: 600; }

  /* Shoppers */
  .shop { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .shop { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .shop__chat { width: 100%; max-width: 460px; justify-self: center; }
  .shop__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .shop__copy .eyebrow { margin-bottom: 0; }
  .shop__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .try { width: 100%; background: var(--teal-raised); border: 1px solid var(--teal-line); border-radius: var(--radius); padding: 20px 22px; display: grid; gap: 12px; justify-items: start; }
  .try__title { font-weight: 700; }
  .try ol { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; color: var(--on-teal-muted); }
  .try li::marker { color: var(--copper); font-weight: 700; }
  .try code { color: var(--white); overflow-wrap: anywhere; font-size: 0.88rem; }
  .try ul { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; }
  .try strong, .try a { color: var(--white); }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }
</style>
