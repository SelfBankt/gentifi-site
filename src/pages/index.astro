---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import CheckForm from '../components/CheckForm.astro';
import ChatMock from '../components/ChatMock.astro';
import Tick from '../components/Tick.astro';
import OverviewFilm from '../components/OverviewFilm.astro';

// The assistants Gentifi is tested in (keep in step with gentifi-toolkit/src/lib/apps.js)
const apps = ['Claude', 'ChatGPT', 'Gemini', 'Grok'];

const shopSteps = [
  { title: 'Send us your price list', body: 'A spreadsheet is fine. You get your own unique link and a place on the Gentifi connector, and AI sees every change you make to the sheet.' },
  { title: 'Put up your sign', body: 'A counter card by the till and a sticker in the window, each with your own code. Got a website? Paste in the snippet we write for it, once.' },
  { title: 'Orders come to your phone', body: 'Customers confirm every order. It arrives in Telegram for you to accept or decline, and they see your answer. Or keep taking orders by email or through your own checkout, as now.' },
];

const phone = [
  { title: 'Check your listing, then go live', body: 'We send you your listing in Telegram. Nothing goes live until you tap Go live.' },
  { title: 'Accept or decline in one tap', body: 'Each order shows what the customer wants and when. Decline as sold out, and AI stops offering it.' },
  { title: 'Sold out? Tap it', body: 'Mark things sold out or back in stock, and customers’ AI sees it within seconds, with the time you said so.' },
  { title: 'New price? Change it there', body: 'Change a price or description in a few taps, and customers’ AI sees it within seconds. For a whole new price board, send a photo and we check every price.' },
];



const customerSteps = [
  { title: 'Scan your sign', body: 'Or tap your link on your website or social pages.' },
  { title: 'Add your shop to their AI', body: 'It takes a minute in Claude, ChatGPT, Gemini or Grok, and they approve it in their own app.' },
  { title: 'Just ask', body: '“Have you got sourdough on Saturday? Save me a loaf.” Nothing is ordered until they check it and tap Confirm.' },
];

const control = [
  'Customers approve every connection, in their own app.',
  'Their AI asks before every booking or order.',
  'Businesses only get their details when they choose to book or buy.',
];
// Tells search engines and AI assistants who Gentifi is
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Gentifi',
  url: 'https://gentifi.com/',
  logo: 'https://gentifi.com/brand/gentifi-app-icon.png',
  email: 'gentifiai@gmail.com',
  description: 'AI optimisation for independent shops, businesses and events: Gentifi puts a business’s products, prices and opening times in its customers’ AI assistants, such as Claude, ChatGPT, Gemini and Grok.',
  areaServed: [
    { '@type': 'Place', name: 'Bristol' },
    { '@type': 'Place', name: 'South Gloucestershire' },
  ],
  sameAs: ['https://github.com/SelfBankt/gentifi-toolkit'],
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Gentifi', url: 'https://gentifi.com/' };
---
<Base
  title="AI optimisation for independent shops in Bristol · Gentifi"
  description="Get your shop found in ChatGPT, Gemini, Claude and Meta AI. AI visibility checks and set-up for independents in Bristol and South Gloucestershire."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organisation)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(website)} />
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <!-- The whole idea in under a minute -->
        <figure class="hero__visual">
          <OverviewFilm />
          <figcaption>Elder Beck Bakery in the film is a fictional example. <a href="/b/demo-business">Try our demo shop.</a></figcaption>
        </figure>

        <div class="hero__copy">
          <span class="eyebrow">AI optimisation for independent shops</span>
          <h1 class="hero__title">Gentifi your business.</h1>
          <p class="hero__tagline">Discoverable and responsive to your customers’ AI.</p>
          <p class="hero__lede">
            Customers scan your sign once to add your shop to their AI assistant. Then they can ask what you have,
            check when you’re open, and reserve or order. Sold out? Tap it on your phone, and their AI knows within seconds.
          </p>
        </div>

        <div class="hero__act">
          <div class="hero__ctas">
            <a class="btn btn--primary" href="/join">Sign up your shop</a>
            <a class="btn btn--ghost" href="#ai-optimisation">Get your AI visibility check</a>
          </div>
          <div class="hero__live">
            <p class="hero__live-label"><Tick size={16} tick="var(--teal)" />Works today in</p>
            <ul class="hero__apps" aria-label="AI assistants">{apps.map((a) => <li>{a}</li>)}</ul>
            <p class="hero__where">Starting in Bristol and South Gloucestershire</p>
          </div>
          <ul class="hero__alt" aria-label="Find your way">
            <li><a href="#shoppers">Shopping? See how to ask your AI</a></li>
            <li><a href="/events">Running a market, show or high street?</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- How it works: for the shop and for its customers -->
    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2>Three steps for you. Three for your customers.</h2>
          <p>Simple for you, and simple for your customers. No website or developer needed, and nothing changes about your till, your checkout or how you take payment.</p>
        </div>
        <div class="sides">
          <article class="side">
            <h3>For your shop</h3>
            <ol>{shopSteps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
          </article>
          <article class="side side--customer">
            <h3>For your customers</h3>
            <ol>{customerSteps.map((s) => <li><strong>{s.title}</strong><span>{s.body}</span></li>)}</ol>
          </article>
        </div>

        <div class="phone">
          <h3>Run it from your phone</h3>
          <p>Your listing, your orders and your stock, in the Telegram app. Your staff can get the orders too.</p>
          <ul>{phone.map((p) => <li><Tick size={20} tick="var(--teal)" /><div><strong>{p.title}</strong><span>{p.body}</span></div></li>)}</ul>
        </div>

      </div>
    </section>

    <!-- AI optimisation -->
    <section class="section section--grey" id="ai-optimisation">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">AI optimisation, done for you</span>
          <h2>Get found by AI, not just by Google.</h2>
          <p>When customers ask ChatGPT, Gemini, Claude or Meta AI about local shops, the answer comes from what AI can read about you. We make sure it reads the right things.</p>
        </div>
        <h3 class="optimise__ask">Ask for your AI visibility check</h3>
        <p class="optimise__what">A one-page report, in plain English, on what your website and Google profile tell AI today.</p>
        <CheckForm />
        <p class="optimise__or">Then we fix what’s missing, and put your shop in Claude, ChatGPT, Gemini and Grok. <a href="/businesses">See everything you get</a>, or <a href="/join">sign up your shop</a>.</p>
      </div>
    </section>

    <!-- Mission: independents first -->
    <section class="section mission-band" id="independents">
      <div class="container mission">
        <div class="mission__copy">
          <span class="eyebrow">Our mission: independents first</span>
          <h2>Bringing independents into the conversation.</h2>
          <p>When someone asks an AI assistant where to buy, book or eat, the big chains already have their data ready. The independent bakery, bike shop, farm shop or maker down the road usually doesn’t, so the AI can’t see them.</p>
          <p>We’re starting with independent businesses in Bristol and South Gloucestershire, and the markets, shows and high streets that bring them together.</p>
        </div>
        <div class="control" id="privacy">
          <h3>Customers are always in control.</h3>
          <ul>{control.map((c) => <li><Tick size={20} tick="var(--white)" /><span>{c}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <!-- Shoppers -->
    <section class="section section--teal" id="shoppers">
      <div class="container">
        <div class="shop">
        <div class="shop__chat"><ChatMock /></div>
        <div class="shop__copy">
          <span class="eyebrow">For shoppers</span>
          <h2>Just ask your AI.</h2>
          <p>
            Add your favourite local shops to your AI assistant. Then ask in plain English: it checks their real
            products, prices and opening times, and asks you before it reserves or buys.
          </p>
          <div class="shop__ctas">
            <a class="btn btn--primary" href="/connector">Ask your AI</a>
            <a class="btn btn--ghost" href="/b/demo-business">Try the demo shop</a>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section waitlist" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Stay in touch</span>
          <h2>Not ready yet? Stay in touch.</h2>
          <p>Leave your name and email, and we’ll keep you posted as Gentifi grows in Bristol and South Gloucestershire, for shops, markets, shows and high streets. Ready now? <a href="/join">Sign up your shop</a> and join the Genesis cohort, our first group of businesses.</p>
        </div>
        <WaitlistForm tone="light" />
      </div>
    </section>

  </main>
  <Footer />

</Base>

<style>
  /* Hero: the overview film across the top, then the promise on the left and the actions on the right */
  .hero { padding-block: clamp(24px, 4vw, 48px) clamp(56px, 8vw, 96px); overflow: hidden; }
  .hero__grid { display: grid; gap: clamp(28px, 4vw, 40px) clamp(40px, 6vw, 72px); }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: start; }
    .hero__visual { grid-column: 1 / -1; }
    .hero__act { padding-top: 12px; }
  }
  .hero__act { min-width: 0; }
  .hero__copy { min-width: 0; }
  .hero__title { font-size: clamp(2.6rem, 7vw, 4.6rem); letter-spacing: -0.04em; line-height: 1; max-width: 10em; }
  .hero__tagline { margin-top: 16px; font-size: clamp(1.3rem, 3vw, 1.8rem); font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; color: var(--copper); max-width: 20em; }
  .hero__lede { margin-top: 20px; font-size: clamp(1.02rem, 2vw, 1.15rem); color: var(--on-teal-muted); max-width: 34rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__live { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; font-size: 0.9rem; }
  .hero__live-label { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .hero__apps { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hero__apps li { padding: 4px 12px; border: 1px solid var(--teal-line); border-radius: 999px; background: var(--teal-raised); font-weight: 600; }
  .hero__where { flex-basis: 100%; color: var(--on-teal-muted); }

  .hero__alt { list-style: none; margin: 24px 0 0; padding: 18px 0 0; border-top: 1px solid var(--teal-line); display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 0.92rem; }
  .hero__alt a { color: var(--white); text-decoration-color: var(--teal-line); }
  .hero__alt a:hover { text-decoration-color: var(--copper); }
  .hero__alt a::after { content: ' \2192'; color: var(--copper); }

  /* The overview film, full width */
  .hero__visual { margin: 0; width: 100%; display: grid; gap: 12px; min-width: 0; }
  .hero__visual figcaption { font-size: 0.85rem; color: var(--on-teal-muted); text-align: center; }
  .hero__visual figcaption a { color: var(--white); text-decoration-color: var(--copper); }

  /* Mission: independents first */
  .mission-band { background: var(--white); }
  .mission { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .mission { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  .control { background: var(--grey); border-radius: var(--radius); padding: 26px 28px; display: grid; gap: 14px; }
  .control h3 { font-size: 1.3rem; }
  .control ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .control li { display: flex; gap: 12px; align-items: flex-start; font-weight: 600; color: var(--ink); }
  .control li :global(svg) { margin-top: 2px; flex-shrink: 0; }

  .mission__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .mission__copy .eyebrow { margin-bottom: 0; }
  .mission__copy > p { color: var(--ink-muted); font-size: 1.08rem; max-width: 36rem; }
  /* How it works: the shop and its customers, side by side */
  .sides { display: grid; gap: 20px; }
  @media (min-width: 860px) { .sides { grid-template-columns: 1fr 1fr; } }
  .side { background: var(--grey); border-radius: var(--radius); padding: 28px; display: grid; gap: 18px; align-content: start; }
  .side--customer { background: var(--teal); color: var(--white); }
  .side h3 { font-size: 1.3rem; }
  .side ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: step; }
  .side li { counter-increment: step; display: grid; grid-template-columns: 36px 1fr; gap: 2px 12px; }
  .side li::before { content: counter(step); grid-row: span 2; width: 32px; height: 32px; border-radius: 50%; background: var(--teal); color: var(--copper); display: grid; place-items: center; font-weight: 700; }
  .side--customer li::before { background: var(--copper); color: var(--teal); }
  .side li span { color: var(--ink-muted); }
  .phone { margin-top: 20px; border: 2px solid var(--grey); border-radius: var(--radius); padding: 28px; display: grid; gap: 12px; }
  .phone h3 { font-size: 1.3rem; }
  .phone > p { color: var(--ink-muted); }
  .phone ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 18px; }
  @media (min-width: 860px) { .phone ul { grid-template-columns: 1fr 1fr; gap: 18px 32px; } }
  .phone li { display: flex; gap: 12px; align-items: flex-start; }
  .phone li :global(svg) { margin-top: 2px; flex-shrink: 0; }
  .phone li div { display: grid; gap: 2px; }
  .phone li span { color: var(--ink-muted); }
  .side--customer li span { color: var(--on-teal-muted); }

  /* AI optimisation */
  .optimise__ask { font-size: 1.2rem; margin: 8px 0 6px; }
  .optimise__what { color: var(--ink-muted); margin-bottom: 16px; }
  .optimise__or { margin-top: 16px; color: var(--ink-muted); }
  .optimise__or a { color: var(--teal); font-weight: 600; }

  /* Shoppers */
  .shop { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 960px) { .shop { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .shop__chat { width: 100%; max-width: 460px; justify-self: center; }
  .shop__copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  .shop__copy .eyebrow { margin-bottom: 0; }
  .shop__copy > p { color: var(--on-teal-muted); font-size: 1.08rem; }
  .shop__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }
</style>
