---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CopyLine from '../components/CopyLine.astro';
import CollectionDiagram from '../components/CollectionDiagram.astro';
import CollectionExplorer from '../components/CollectionExplorer.astro';
import CollectionValidator from '../components/CollectionValidator.astro';
import { collectionDoc, memberBacklink } from '../data/demoShow';

const specRepo = 'https://github.com/SelfBankt/collections-spec';
const profileRepo = 'https://github.com/SelfBankt/gentifi-profile';
const profileSchema = '/standards/profile-0.1.schema.json';
const profileSlot = JSON.stringify({
  type: 'slot',
  slot_id: 'tour_20261017_1000',
  offering_id: 'farm_tour',
  start: '2026-10-17T10:00:00+01:00',
  end: '2026-10-17T11:00:00+01:00',
  remaining: 4,
  freshness: { observed_at: '2026-10-15T19:30:00+01:00', confidence: 'confirmed', source: 'integration' },
}, null, 2);
const specDoc = `${specRepo}/blob/main/spec/collections-0.2.md`;
const schemaPath = '/standards/collections-0.2.schema.json';
const ardSpec = 'https://agenticresourcediscovery.org/spec';

const exampleJson = JSON.stringify(collectionDoc(2), null, 2);
const backlinkJson = JSON.stringify(memberBacklink, null, 2);

// Versions and stewardship checked 11 October 2026.
const stack = [
  {
    layer: 'Groups of businesses',
    items: [{ name: 'Business Collections', who: 'Proposed by Gentifi · draft 0.2, on ARD', href: '#draft' }],
    proposed: true,
  },
  {
    layer: 'One business, with freshness',
    items: [{ name: 'Gentifi Business Profile', who: 'Proposed by Gentifi · draft 0.1', href: '#profile' }],
    proposed: true,
  },
  {
    layer: 'Discovery',
    items: [
      { name: 'Agentic Resource Discovery (ard.json)', who: 'Proposal v0.91, August 2026 · replaces ai-catalog.json', href: 'https://agenticresourcediscovery.org/spec' },
      { name: 'MCP Server Cards', who: 'MCP extension, SEP-2127', href: 'https://modelcontextprotocol.io/seps/2127-mcp-server-cards' },
    ],
  },
  {
    layer: 'Agent instructions',
    items: [{ name: 'Agent Skills (SKILL.md)', who: 'agentskills.io open standard', href: 'https://agentskills.io' }],
  },
  {
    layer: 'Tools and data',
    items: [{ name: 'Model Context Protocol (MCP)', who: 'Agentic AI Foundation (Linux Foundation) · spec 2026-07-28', href: 'https://modelcontextprotocol.io' }],
  },
  {
    layer: 'Agent to agent',
    items: [{ name: 'A2A', who: 'Agentic AI Foundation (Linux Foundation) · v1.0', href: 'https://a2a-protocol.org' }],
  },
  {
    layer: 'Search engines and AI search',
    items: [{ name: 'schema.org', who: 'LocalBusiness, Product and Offer', href: 'https://schema.org/LocalBusiness' }],
  },
  {
    layer: 'Commerce',
    items: [
      { name: 'UCP', who: 'Google and Shopify', href: 'https://www.shopify.com/ucp' },
      { name: 'ACP', who: 'OpenAI and Stripe', href: 'https://www.agenticcommerce.dev/' },
    ],
  },
  {
    layer: 'Payments',
    items: [
      { name: 'x402', who: 'x402 Foundation (Linux Foundation)', href: 'https://www.linuxfoundation.org/press/linux-foundation-is-launching-the-x402-foundation-and-welcoming-the-contribution-of-the-x402-protocol' },
      { name: 'L402', who: 'Lightning Labs', href: 'https://lightning.engineering/posts/2026-03-11-L402-for-agents/' },
      { name: 'AP2', who: 'Google, extends A2A' },
    ],
  },
];

const gaps = [
  {
    n: '01',
    title: 'Groups of businesses',
    body: 'Every spec describes one business at one domain. Nothing describes a group: an event, a high street, a market, a trade body.',
    status: 'Draft 0.2 below',
    key: true,
  },
  {
    n: '02',
    title: 'Services, bookings and quotes',
    body: 'Commerce specs centre on products and carts. Appointments, table bookings, call-outs and B2B quote requests need their own shape.',
    status: 'Reviewing UCP extensions first',
  },
  {
    n: '03',
    title: 'Businesses without a website',
    body: 'Specs assume you can host files at /.well-known/. Most small businesses can’t.',
    status: 'Gentifi hosts; the format stays open',
  },
  {
    n: '04',
    title: 'Local and live data',
    body: 'Opening hours, service area, today’s availability and stock, in a form agents can trust.',
    status: 'Exploring',
  },
  {
    n: '05',
    title: 'Bitcoin payments in commerce',
    body: 'An L402 and Lightning payment option for agent checkout.',
    status: 'Exploring',
  },
];

const fields = [
  ['id', 'The collection, as an ARD identifier', '"urn:air:shows.example:collection:demo-selfbuild-2027"'],
  ['name', 'Display name', '"Demo Self Build Show 2027"'],
  ['kind', 'Type of group', 'event · place · association · marketplace'],
  ['publisher', 'Who curates it, and the domain it is served from', 'The event organiser'],
  ['validFrom, validTo', 'Time window, for events', 'Show dates; members stay reachable after'],
  ['area', 'Geography, for places', 'Country, postal code prefixes or a boundary'],
  ['facets', 'Terms on the entries agents can filter by', '"col:category", "col:priceFrom", "col:stand"'],
  ['memberOf', 'For a nested collection: the parents it agrees to join', 'A trade body that includes the show'],
];

const terms = [
  ['col:category', 'The member\u2019s category in this collection', '"glazing"'],
  ['col:stand', 'Stand, pitch or unit', '"B12"'],
  ['col:tier', 'Sponsor or membership tier', '"gold"'],
  ['col:priceFrom', 'Lowest price, for filtering', '{ "amount": 540, "currency": "GBP", "unit": "m\u00b2" }'],
  ['col:manifest', 'Where a hosted member\u2019s own manifest is', 'Its host\u2019s page for the business'],
  ['col:memberOf', 'In the member\u2019s own manifest: collections it belongs to', 'Rule 1'],
];

const changes = [
  'A collection is now an ARD manifest: its entries are the members, so any ARD client can read it.',
  'Members point to their own resources, such as their MCP server card, with ARD identifiers.',
  'Roles and facets are namespaced terms, which ARD registries can already filter on.',
  'Businesses without a website can be members through the platform that hosts them.',
];

const questions = [
  {
    q: 'Extend ARD, or stand alone?',
    issue: 1,
    body: 'Proposed: extend ARD through its namespace mechanism, as draft 0.2 does. Still open: should the col terms and the collection media type move into ARD\u2019s own context?',
  },
  {
    q: 'How should membership be verified?',
    issue: 2,
    body: 'Proposed: the back-link in the member\u2019s own manifest, required. Still open: should members also be able to sign their entry, so registries can cache proof?',
  },
  {
    q: 'Should a collection run its own search?',
    issue: 3,
    body: 'Proposed: no new API. Agents filter the document, or the publisher runs an ARD registry, which already filters on namespaced terms.',
  },
  {
    q: 'Which facets should be standard?',
    issue: 4,
    body: 'Proposed: a small core (category, stand, tier, price from) plus the publisher\u2019s own terms. Still open: a shared category vocabulary, and mapping to schema.org.',
  },
];

const path = [
  { step: 'Draft 0.1', body: 'First proposal, with a JSON Schema, examples and a validator.', done: true },
  { step: 'Draft 0.2', body: 'Rebuilt on ARD v0.91, with proposed answers to every open question.', now: true },
  { step: 'Reference implementation', body: 'The Gentifi Toolkit publishes back-links for businesses and checks collections, membership included.', now: true },
  { step: 'Proposal upstream', body: 'Offered to the ARD maintainers as a neutral extension, with Gentifi as author and first implementation.' },
];
---
<Base
  title="Business Collections: an open standard · Gentifi"
  description="Business Collections is Gentifi’s open draft for describing a whole show, market, high street or trade body to AI agents. Read the draft and check a collection."
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">Open standards · Draft proposal</span>
          <h1>Agents can find a business. <span class="hl">Business Collections</span> let them find a whole street.</h1>
          <p class="hero__lede">
            Today's agent standards describe one business at a time. Business Collections is our open draft for describing a
            whole group, like a trade show, high street or market, so one connection covers every member. Each
            business keeps its own data and checkout.
          </p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="#draft">Read the draft</a>
            <a class="btn btn--ghost" href="#explorer">Try the explorer</a>
          </div>
          <p class="hero__meta">Draft 0.2 · 11 October 2026 · Builds on ARD v0.91 · Apache-2.0 · <a href={specDoc}>Spec on GitHub</a> · <a href={schemaPath} download>JSON Schema</a></p>
        </div>
        <div class="hero__visual"><CollectionDiagram /></div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section" id="stack">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">The stack</span>
          <h2>Built on open standards. Adding the missing layer.</h2>
          <p>Gentifi uses existing open standards for everything they already cover, and proposes new pieces only where there's a gap. The <a href="/toolkit">toolkit</a> generates every format in this list except commerce and payments.</p>
        </div>
        <ol class="stack">
          {stack.map((s) => (
            <li class:list={['stack__row', { 'stack__row--proposed': s.proposed }]}>
              <span class="stack__layer">{s.layer}</span>
              <div class="stack__items">
                {s.items.map((it) => (
                  <div class="stack__item">
                    {it.href ? <a href={it.href} class="stack__name">{it.name}</a> : <span class="stack__name">{it.name}</span>}
                    <span class="stack__who">{it.who}</span>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ol>
        <p class="stack__note">Versions and stewardship as of 11 October 2026.</p>
      </div>
    </section>

    <!-- Gaps -->
    <section class="section section--grey" id="gaps">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">The gaps</span>
          <h2>Five things today's specs don't cover.</h2>
          <p>Each one matters most to exactly the businesses Gentifi serves: small, local and independent.</p>
        </div>
        <ol class="gaps">
          {gaps.map((g) => (
            <li class:list={['gap', { 'gap--key': g.key }]}>
              <span class="gap__n">{g.n}</span>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
              <span class="gap__status">{g.status}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Draft spec -->
    <section class="section" id="draft">
      <div class="container spec">
        <aside class="spec__toc" aria-label="Draft contents">
          <p class="spec__toc-title">Business Collections 0.2</p>
          <ol>
            <li><a href="#abstract">Abstract</a></li>
            <li><a href="#changes">What changed in 0.2</a></li>
            <li><a href="#fields">The collection</a></li>
            <li><a href="#terms">Member terms</a></li>
            <li><a href="#rules">Rules</a></li>
            <li><a href="#example">Example</a></li>
            <li><a href="#hosted">Hosted members</a></li>
            <li><a href="#ard">Relationship to ARD</a></li>
            <li><a href="#questions">Open questions</a></li>
          </ol>
          <a class="btn btn--teal btn--block" href={schemaPath} download>Download JSON Schema</a>
          <a class="spec__toc-gh" href={specRepo}>Spec, examples and issues on GitHub</a>
        </aside>

        <article class="spec__body">
          <span class="eyebrow">Draft specification</span>
          <h2>Business Collections: describing groups of businesses to AI agents</h2>
          <dl class="spec__status">
            <div><dt>Version</dt><dd>0.2 (draft), superseding 0.1</dd></div>
            <div><dt>Date</dt><dd>11 October 2026</dd></div>
            <div><dt>Author</dt><dd>Gentifi</dd></div>
            <div><dt>Builds on</dt><dd><a href={ardSpec}>Agentic Resource Discovery (ARD) v0.91</a></dd></div>
            <div><dt>Status</dt><dd>Proposal for discussion, not a standard.</dd></div>
            <div><dt>Licence</dt><dd>Apache-2.0</dd></div>
          </dl>

          <h3 id="abstract">Abstract</h3>
          <p>
            A collection describes a group of businesses, so one connection lets an agent work with every member. In
            draft 0.2 a collection is an ARD manifest: its <code>entries</code> are the members, and a
            <code>collection</code> object says what the group is. An ARD client that knows nothing about collections
            still sees a usable list of resources. Each member keeps its own data and checkout.
          </p>

          <h3 id="motivation">Motivation</h3>
          <ul>
            <li>An attendee adds one event connector instead of 300 exhibitor connectors.</li>
            <li>A high street, market or trade association can publish all its members in one place.</li>
            <li>Each member stays independent: its own data and checkout. After the event, it stays in the attendee's agent.</li>
          </ul>

          <h3 id="changes">What changed in 0.2</h3>
          <p>
            In August 2026, ARD v0.91 moved discovery to <code>/.well-known/ard.json</code> (it was
            <code>ai-catalog.json</code>) and added identifiers, namespaced terms and registry search. Draft 0.2 uses
            them instead of defining its own:
          </p>
          <ul>{changes.map((c) => <li>{c}</li>)}</ul>

          <h3 id="fields">The collection</h3>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Fields of the collection object</caption>
              <thead><tr><th scope="col">Field</th><th scope="col">Meaning</th><th scope="col">Example</th></tr></thead>
              <tbody>
                {fields.map(([f, m, e]) => <tr><th scope="row"><code>{f}</code></th><td>{m}</td><td>{e}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="spec__after-table"><code>id</code>, <code>name</code>, <code>kind</code> and <code>publisher</code> are required, with at least one entry. The <a href={schemaPath} download>JSON Schema</a> is the precise definition.</p>

          <h3 id="terms">Member terms</h3>
          <p>Each member is an ordinary ARD entry (identifier, name, type and a link to its own resource), plus these terms in the <code>col</code> namespace:</p>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Business Collections terms on member entries</caption>
              <thead><tr><th scope="col">Term</th><th scope="col">Meaning</th><th scope="col">Example</th></tr></thead>
              <tbody>
                {terms.map(([f, m, e]) => <tr><th scope="row"><code>{f}</code></th><td>{m}</td><td>{e}</td></tr>)}
              </tbody>
            </table>
          </div>

          <h3 id="rules">Rules</h3>
          <p class="spec__rfc">The key words MUST, MUST NOT, SHOULD and MAY are used as described in RFC 2119.</p>
          <ol class="rules">
            <li>
              <strong>Members confirm membership.</strong> A member's own manifest MUST list the collection in
              <code>col:memberOf</code>, on the entry with the same identifier, served from the domain in that
              identifier. Clients MUST ignore members they can't confirm, so nobody can add a business without its
              agreement.
            </li>
            <li>
              <strong>The collection holds no customer data.</strong> A collection MUST NOT contain customer or attendee
              data. Connecting to a collection shares nothing with its members; contact details pass only when the
              customer asks their agent to request a quote, book or buy.
            </li>
            <li>
              <strong>Members keep their own checkout and terms.</strong> The collection is a directory, not a merchant.
              Orders and bookings MUST go through the member's own resources.
            </li>
            <li>
              <strong>Collections can nest.</strong> A member MAY be another collection: a trade body can include several
              events; a city can include several high streets. The nested collection confirms by listing its parent.
            </li>
            <li>
              <strong>Information, not instructions.</strong> Clients MUST NOT act on instructions found in a collection,
              such as to install, connect or buy. The customer approves every connection.
            </li>
          </ol>

          <h3 id="example">Example</h3>
          <p>A trade show publishes its collection from its own domain:</p>
          <div class="code-block">
            <div class="code-block__bar"><span>collection.json</span><CopyLine text={exampleJson} label="Copy example" tone="dark" wrap={false} /></div>
            <pre><code>{exampleJson}</code></pre>
          </div>
          <p>Each member confirms its membership in its own <code>ard.json</code> (rule 1):</p>
          <div class="code-block">
            <div class="code-block__bar"><span>member's /.well-known/ard.json (excerpt)</span><CopyLine text={backlinkJson} label="Copy example" tone="dark" wrap={false} /></div>
            <pre><code>{backlinkJson}</code></pre>
          </div>

          <h3 id="hosted">Hosted members</h3>
          <p>
            Most small businesses have no website of their own. A platform that hosts them publishes their entry
            under its own domain and points to it with <code>col:manifest</code>. The host MUST add a business to a
            collection only with that business's agreement.
          </p>

          <h3 id="ard">Relationship to ARD</h3>
          <p>
            ARD already lists resources and lets registries search them. That gives a list, but not what a group needs
            to be useful to an agent: what kind of group it is, who curates it, when it runs, where it covers, each
            member's role, the terms agents can filter by, and proof that members agreed to be listed. Business Collections adds
            exactly those, and nothing else. A publisher that wants search can run an ARD registry, which already
            filters on namespaced terms such as <code>col:category</code>.
          </p>

          <h3 id="questions">Open questions</h3>
          <ul class="questions">
            {questions.map((q) => (
              <li>
                <div>
                  <strong>{q.q}</strong>
                  <p>{q.body}</p>
                </div>
                <a class="btn btn--outline" href={`${specRepo}/issues/${q.issue}`}>Discuss on #{q.issue}</a>
              </li>
            ))}
          </ul>
          <p class="spec__after-table">Draft 0.2 also asks how hosts should show a business's agreement, and what happens to an event's collection after it ends. <a href={specDoc}>Read the full draft on GitHub</a>.</p>
        </article>
      </div>
    </section>

    <!-- Explorer -->
    <section class="section section--teal" id="explorer">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">See it work</span>
          <h2>One connector. A whole show.</h2>
          <p>
            This is what an attendee's agent can do with a single collection. Ask a question, and the agent filters every
            exhibitor by the collection's facets. Nothing is shared with anyone until you say so.
          </p>
        </div>
        <CollectionExplorer />
      </div>
    </section>

    <!-- Validator -->
    <section class="section section--grey" id="validate">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Validate</span>
          <h2>Check a collection against the draft.</h2>
          <p>Paste your own, or break the example and see what the rules catch. Prefer tooling? <a href={schemaPath} download>Download the JSON Schema</a>.</p>
        </div>
        <div class="validator-wrap">
          <CollectionValidator />
        </div>
      </div>
    </section>

    <!-- Business Profile -->
    <section class="section" id="profile">
      <div class="container spec">
        <aside class="spec__toc" aria-label="Business Profile contents">
          <p class="spec__toc-title">Business Profile 0.1</p>
          <ol>
            <li><a href="#profile-abstract">Abstract</a></li>
            <li><a href="#profile-freshness">Freshness</a></li>
            <li><a href="#profile-confirm">The customer confirms</a></li>
            <li><a href="#profile-repo">What's in the repository</a></li>
          </ol>
          <a class="btn btn--teal btn--block" href={profileSchema} download>Download JSON Schema</a>
          <a class="spec__toc-gh" href={profileRepo}>Schema, validator and issues on GitHub</a>
        </aside>

        <article class="spec__body">
          <span class="eyebrow">Draft specification</span>
          <h2>Gentifi Business Profile: what one business offers, and how sure an agent can be</h2>
          <dl class="spec__status">
            <div><dt>Version</dt><dd>0.1 (draft)</dd></div>
            <div><dt>Date</dt><dd>15 October 2026</dd></div>
            <div><dt>Author</dt><dd>Gentifi</dd></div>
            <div><dt>Status</dt><dd>Proposal for discussion, not a standard.</dd></div>
            <div><dt>Licence</dt><dd>Apache-2.0</dd></div>
          </dl>

          <h3 id="profile-abstract">Abstract</h3>
          <p>
            An open format that describes what a local business offers, what's available right now, and what an AI agent
            may do on its behalf: hold, book, order, cancel, check status or enquire. It's designed for businesses without
            live inventory systems: the farm shop, the plumber, the independent café. The same profile can be served over
            MCP, published as structured data on a website, or carried by other agent protocols.
          </p>

          <h3 id="profile-freshness">Every piece of availability says how sure you can be</h3>
          <p>
            Each stock level, bookable slot or recurring pattern carries when it was last confirmed, how confident that is,
            and where it came from: the owner, a synced booking or till system, or a message the owner sent. An agent can
            then tell whether a booking can be confirmed straight away, whether the business needs to confirm it first, or
            whether to warn the customer that the information may be out of date.
          </p>
          <div class="code-block">
            <div class="code-block__bar"><span>a bookable slot</span><CopyLine text={profileSlot} label="Copy example" tone="dark" wrap={false} /></div>
            <pre><code>{profileSlot}</code></pre>
          </div>

          <h3 id="profile-confirm">The customer always confirms</h3>
          <p>
            Every hold, booking or order carries <code>customer_confirmation</code>: how and when the customer agreed to
            exactly that request, in their AI app or on a confirmation page. An agent never commits a customer on its own.
            Requests come back with a clear receipt: confirmed, pending (with a time the business will reply by), or
            declined with a reason and alternatives. Retries are safe: every request carries an idempotency key.
          </p>

          <h3 id="profile-repo">What's in the repository</h3>
          <ul>
            <li>The JSON Schema, with worked examples: a farm shop and a mobile plumber, both fictional.</li>
            <li>A validator that checks ids, slots and stale data as well as structure.</li>
            <li>A reference MCP server for trying the format with real agents.</li>
          </ul>
          <p>
            The Gentifi toolkit can already write a business in this format (<code>gentifi profile</code>). See the
            <a href="/b/demo-business/profile.json">demo shop's profile</a>: it marks stock as likely, from the owner, as of the
            last change to the shop's sheet, because a spreadsheet can't say more than that.
          </p>
          <p class="spec__after-table">
            The reference server isn't the live Gentifi service: that runs on the <a href="/toolkit">Gentifi toolkit</a>,
            which will publish businesses in this format. If you've tried describing a real business and something didn't
            fit, please <a href={`${profileRepo}/issues`}>open an issue</a>.
          </p>
        </article>
      </div>
    </section>

    <!-- Path -->
    <section class="section" id="path">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">From draft to standard</span>
          <h2>Neutral by design. Built in the open.</h2>
          <p>
            The format carries no brand: no "gentifi" in any field name. Gentifi's part is to write the draft, build the
            first implementation, and take it to the people who maintain the specs it extends.
          </p>
        </div>
        <ol class="path">
          {path.map((p) => (
            <li class:list={{ 'path--now': p.now }}>
              <span class="path__n">{p.now ? 'Now' : p.done ? 'Done' : 'Next'}</span>
              <h3>{p.step}</h3>
              <p>{p.body}</p>
            </li>
          ))}
        </ol>
        <div class="path__cta">
          <a class="btn btn--teal" href={`${specRepo}/issues`}>Join the discussion on GitHub</a>
          <a class="btn btn--outline" href={specRepo}>Spec on GitHub</a>
          <a class="btn btn--outline" href={schemaPath} download>Download JSON Schema</a>
        </div>
      </div>
    </section>

    <!-- Organisers -->
    <section class="section section--teal" id="waitlist">
      <div class="container org">
        <div class="section-head">
          <span class="eyebrow">Your show, your market, your high street</span>
          <h2>Want the first Business Collection to be yours?</h2>
          <p>
            We're looking for one show, market, high street or trade body to publish the first real Business Collection
            with us. Your traders, exhibitors or members become reachable from every visitor's AI assistant.
          </p>
          <a class="btn btn--primary" href="/events#enquire">Tell us about your event</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
