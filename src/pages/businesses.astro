---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import CounterCard from '../components/CounterCard.astro';
import WebBadges from '../components/WebBadges.astro';
import Tick from '../components/Tick.astro';

const toolkitZip = 'https://github.com/SelfBankt/gentifi-toolkit/archive/refs/heads/main.zip';

const benefits = [
  { title: 'Found by AI agents', body: 'Agents can see what you sell, what it costs and when you’re open.' },
  { title: 'Listed where customers look', body: 'We get you into the Claude and ChatGPT connector directories.' },
  { title: 'Works with any agent', body: 'Including the ones people build for themselves.' },
  { title: 'Safe checkout', body: 'Customers confirm every order, then pay through your own checkout.' },
  { title: 'A chat assistant, if you want one', body: 'For customers without an agent, on WhatsApp, Telegram or your website.' },
  { title: 'See what you sell', body: 'A simple view of what agents sold for you.' },
];

const steps = [
  { title: 'Join the waitlist', body: 'Tell us about your business. We’re starting with a small group.' },
  { title: 'We set you up', body: 'We bring in your products, prices or bookings from Shopify, a spreadsheet or your booking system.' },
  { title: 'Put up your sticker', body: 'Customers scan it, add you to their agent, and start asking.' },
];

const examples = [
  { setting: 'Farm shop', ask: 'Which farm near me has eggs this week? Reserve a dozen.', gets: 'Reservations without answering the phone.' },
  { setting: 'Restaurant', ask: 'Book a table for four on Friday at 7.', gets: 'Bookings through your usual booking page.' },
  { setting: 'Trades', ask: 'Find a plumber free on Tuesday and get a price.', gets: 'Quote requests with the details you need.' },
  { setting: 'Trade show', ask: 'Which stands sell triple glazing under £600/m²?', gets: 'One connection covers every exhibitor at the show.' },
];

const pricing = [
  { label: 'Setup', price: '[SETUP FEE]', body: 'One-off. We bring in your products and get you listed.' },
  { label: 'Monthly', price: '[MONTHLY FEE]', body: 'Keeps your prices, stock and times up to date.' },
  { label: 'Per order', price: '[PER-ORDER FEE]', body: 'A small fee, only on orders that agents bring you.' },
];

const faqs = [
  {
    q: 'Do I need a website or a developer?',
    a: 'No. We host everything for you. If you do have a developer, they can use our free, open-source toolkit instead.',
  },
  {
    q: 'Which AI agents does it work with?',
    a: 'Claude, ChatGPT and other agents that follow the same open standards. Customers without an agent can use the optional chat assistant.',
  },
  {
    q: 'Can an agent order something my customer didn’t want?',
    a: 'No. Customers confirm every order before it goes through, and agents can’t connect to you or buy without their approval.',
  },
  {
    q: 'Am I locked in?',
    a: 'No. Everything we make is open source and uses open standards, so your setup is never tied to us.',
  },
];
---
<Base
  title="For businesses · Gentifi"
  description="Get found and bought through AI agents like Claude and ChatGPT. No website or developer needed. Free, open-source toolkit."
>
  <Header ctaHref="#waitlist" />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container">
        <span class="eyebrow">For businesses</span>
        <h1>Get found and bought through AI agents.</h1>
        <p class="hero__lede">
          When customers ask Claude, ChatGPT or another AI agent for something you sell, Gentifi makes sure it can
          find you, check your prices, and book or buy.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="#waitlist">Join the waitlist</a>
          <a class="btn btn--ghost" href={toolkitZip}>Download the free toolkit</a>
        </div>
        <ul class="hero__points">
          <li><Tick size={18} tick="var(--teal)" />No website or developer needed</li>
          <li><Tick size={18} tick="var(--teal)" />Keep your own checkout</li>
          <li><Tick size={18} tick="var(--teal)" />Open source, no lock-in</li>
        </ul>
      </div>
    </section>

    <!-- What you get -->
    <section class="section" id="offer">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">What you get</span>
          <h2>Everything agents need, done for you.</h2>
        </div>
        <ul class="benefits">
          {benefits.map((b) => (
            <li>
              <Tick size={22} tick="var(--white)" />
              <div><h3>{b.title}</h3><p>{b.body}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Sticker -->
    <section class="section section--grey">
      <div class="container sticker-row">
        <div class="sticker-row__copy">
          <span class="eyebrow">Your sticker</span>
          <h2>One sticker. Any agent.</h2>
          <p>
            Put it in your window, by the till, on your website or in your emails. Customers scan it to add you to
            their agent, and approve it in their own app.
          </p>
          <WebBadges />
          <p><a class="sticker-row__link" href="/b/demo-business">See what a scan opens</a></p>
        </div>
        <div class="sticker-row__card"><CounterCard /></div>
      </div>
    </section>

    <!-- Steps -->
    <section class="section" id="how">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Getting started</span>
          <h2>Three steps to agent-ready.</h2>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="steps__n" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
        <p class="diy"><a href="/how-it-works">See how it works in detail</a>. Prefer to do it yourself? Our <a href="/toolkit">toolkit</a> is free and open source.</p>
      </div>
    </section>

    <!-- Examples -->
    <section class="section section--grey" id="examples">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Examples</span>
          <h2>What customers ask.</h2>
        </div>
        <div class="examples">
          {examples.map((e) => (
            <article class="example">
              <span class="example__setting">{e.setting}</span>
              <q>{e.ask}</q>
              <p>{e.gets}</p>
            </article>
          ))}
        </div>
        <p class="b2b">Selling to other businesses? It works the same way, with account prices, approvals and invoices.</p>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section" id="pricing">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Pricing</span>
          <h2>Simple pricing. Free for customers.</h2>
          <p>Final prices are still being set.</p>
        </div>
        <div class="pricing">
          {pricing.map((p) => (
            <article class="price">
              <h3>{p.label}</h3>
              <p class="price__amount"><span class="placeholder">{p.price}</span></p>
              <p>{p.body}</p>
            </article>
          ))}
        </div>
        <p class="organisers">
          Running an event, market or trade body? One connection can cover all your members.
          <a href="/standards">See how</a>
        </p>
      </div>
    </section>

    <!-- Open -->
    <section class="section section--teal open-band">
      <div class="container open-band__inner">
        <div>
          <span class="eyebrow">Open by design</span>
          <h2>Open source, so you're never locked in.</h2>
          <p>The toolkit behind Gentifi is free and open source, and everything follows open standards, so your setup is never tied to us.</p>
        </div>
        <div class="open-band__buttons">
          <a class="btn btn--primary" href="/toolkit">See the toolkit</a>
          <a class="btn btn--ghost" href="/standards">Open standards</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--grey" id="faq">
      <div class="container faq__wrap">
        <div class="section-head">
          <span class="eyebrow">Questions</span>
          <h2>Common questions.</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section section--teal" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Waitlist</span>
          <h2>Make your business agent-ready.</h2>
          <p>We're starting with a small group of local businesses. Join the list and we'll be in touch.</p>
          <p class="waitlist__count"><span class="placeholder">[WAITLIST COUNT]</span> already signed up</p>
        </div>
        <WaitlistForm role="business" />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 8vw, 96px); }
  .hero h1 { max-width: 15em; }
  .hero__lede { margin-top: 20px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 38rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__points { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 0.95rem; }
  .hero__points li { display: flex; align-items: center; gap: 8px; }

  /* Benefits */
  .benefits { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px 40px; }
  @media (min-width: 720px) { .benefits { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .benefits { grid-template-columns: repeat(3, 1fr); } }
  .benefits li { display: flex; gap: 14px; align-items: flex-start; }
  .benefits li :global(svg) { margin-top: 2px; flex-shrink: 0; }
  .benefits h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .benefits p { color: var(--ink-muted); }

  /* Sticker */
  .sticker-row { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .sticker-row { grid-template-columns: 1.3fr 1fr; gap: 64px; } }
  .sticker-row__copy { display: grid; gap: 16px; justify-items: start; }
  .sticker-row__copy .eyebrow { margin-bottom: 0; }
  .sticker-row__copy > p { color: var(--ink-muted); max-width: 34rem; }
  .sticker-row__link { font-weight: 600; color: var(--teal); }
  .sticker-row__card { max-width: 340px; width: 100%; justify-self: center; }

  /* Steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  @media (min-width: 800px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .steps li { display: grid; gap: 10px; align-content: start; }
  .steps__n {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--teal); color: var(--copper);
    display: grid; place-items: center;
    font-weight: 700; font-size: 1.1rem;
  }
  .steps h3 { font-size: 1.2rem; margin-top: 4px; }
  .steps p { color: var(--ink-muted); }
  .diy { margin-top: 32px; color: var(--ink-muted); }
  .diy a { color: var(--teal); font-weight: 600; }

  /* Examples */
  .examples { display: grid; gap: 16px; }
  @media (min-width: 720px) { .examples { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .examples { grid-template-columns: repeat(4, 1fr); } }
  .example { background: var(--white); border-radius: var(--radius); padding: 22px; display: grid; gap: 10px; align-content: start; }
  .example__setting { font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); }
  .example q { font-size: 1.05rem; font-weight: 600; line-height: 1.4; }
  .example p { color: var(--ink-muted); font-size: 0.95rem; }
  .b2b { margin-top: 24px; color: var(--ink-muted); }

  /* Pricing */
  .pricing { display: grid; gap: 20px; }
  @media (min-width: 860px) { .pricing { grid-template-columns: repeat(3, 1fr); } }
  .price { border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; display: grid; gap: 8px; align-content: start; }
  .price p:not(.price__amount) { color: var(--ink-muted); }
  .price__amount { font-size: 1.2rem; font-weight: 700; }
  .organisers { margin-top: 24px; color: var(--ink-muted); }
  .organisers a { color: var(--teal); font-weight: 600; }

  /* Open band */
  .open-band__inner { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 900px) { .open-band__inner { grid-template-columns: 1fr auto; gap: 48px; } }
  .open-band h2 { margin-bottom: 14px; }
  .open-band p { color: var(--on-teal-muted); max-width: 40rem; }
  .open-band__buttons { display: flex; flex-wrap: wrap; gap: 12px; }

  /* FAQ */
  .faq__wrap { max-width: calc(820px + var(--gutter) * 2); }
  .faq { border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 40px 20px 0;
    font-weight: 600;
    font-size: 1.05rem;
    position: relative;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 4px; top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .faq details[open] summary::after { content: '\2212'; }
  .faq details p { padding: 0 0 20px; color: var(--ink-muted); max-width: 44rem; }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }
  .waitlist__count { font-size: 0.95rem; color: var(--on-teal-muted); }
</style>
