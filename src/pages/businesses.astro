---
import Base from '../layouts/Base.astro';
import { faqSchema } from '../data/faqSchema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import CounterCard from '../components/CounterCard.astro';
import WebBadges from '../components/WebBadges.astro';
import Tick from '../components/Tick.astro';
import BakeryFilm from '../components/BakeryFilm.astro';

// What a business gets today, grouped as on the Hobbs House one-pager (docs/pilots/hobbs-house-offer.html)
const today = [
  {
    title: 'Get found by AI',
    items: [
      { title: 'An AI visibility check', body: 'A one-page report on what your website and Google profile tell AI today, in plain English.' },
      { title: 'Your website, made AI-readable', body: 'Structured data that tells AI you’re a local shop, where you are and when you’re open. Paste it in once, and your site looks the same.' },
      { title: 'Your Google profile, checked', body: 'Name, hours, holiday hours, category and products, so AI answers about you correctly.' },
    ],
  },
  {
    title: 'Your shop in customers’ AI',
    items: [
      { title: 'Found by AI assistants', body: 'Customers’ AI can see what you sell, what it costs and when you’re open.' },
      { title: 'Your own link and the Gentifi connector', body: 'A link for your signs, website and social pages. Customers add the Gentifi connector once, then ask their AI about you by name.' },
      { title: 'A sheet you keep', body: 'Change prices and products in your Google Sheet, and AI sees the update within ten minutes.' },
      { title: 'Check it, then go live', body: 'We send you your listing in Telegram. Nothing shows until you tap Go live.' },
    ],
  },
  {
    title: 'Orders, confirmed by the customer',
    items: [
      { title: 'Orders on your phone', body: 'Each order a customer confirms arrives in Telegram for you to accept or decline, and the customer sees your answer. Your staff can get them too. Or keep taking orders by email or through your own checkout.' },
      { title: 'A witness for every order', body: 'Customers confirm on a Gentifi page before an order reaches you. We keep a record of what each one agreed, at what price and when, with a reference that comes with the order.' },
    ],
  },
  {
    title: 'Signs and results',
    items: [
      { title: 'Your signs', body: 'A window sticker and a counter card with your own code, ready to print.' },
      { title: 'See what AI does for you', body: 'Daily counts of how often your page was opened, how often customers’ AI asked about you, how often you came up in searches, and how many orders were confirmed. Numbers only, never who.' },
    ],
  },
];

const coming = [
  { title: 'One-tap adding', body: 'Customers add your shop from inside their AI app, without copying a link.' },
  { title: 'A chat assistant', body: 'For customers without an AI assistant, on WhatsApp or your website.' },
  { title: 'Live till and online-shop connections', body: 'Stock that updates as you sell, and orders that land on your till.' },
];

// Who fits best today (concept brief, "Who fits best")
const fits = [
  { title: 'Bakeries', body: 'Bread that sells out, and cakes and celebration bakes ordered ahead.' },
  { title: 'Farm shops, butchers and fishmongers', body: 'Seasonal stock, meat boxes and Christmas pre-orders.', link: { href: '/farm-shops', label: 'For farm shops' } },
  { title: 'Delis, cheesemongers and greengrocers', body: '“Is the Stilton in?” “Got any asparagus?” Refill shops too.' },
  { title: 'Florists and makers', body: 'Bouquets, wreaths and gift boxes made to order for collection.' },
  { title: 'Specialist shops', body: 'Bookshops, plant nurseries, bike shops, wine merchants: anywhere customers check stock before the trip.' },
  { title: 'Markets and events', body: 'Every trader in one place, through one connection.', link: { href: '/events', label: 'For organisers' } },
];

// A shop owner's day: the guide's "What do I need to do each day?" question
const day = [
  { title: 'Orders come to you', body: 'By email or your own checkout, as now. Or in Telegram on your phone: tap Accept or Decline.' },
  { title: 'Sold out? One tap.', body: 'Tap sold out in Telegram, and customers’ AI sees it within seconds. Next morning, one tap puts everything back in stock. Only if you want to.' },
  { title: 'New prices? Send them.', body: 'Change your Google Sheet, send the change in Telegram, or send a photo of your price board.' },
  { title: 'Nothing else', body: 'No website to update, no new till, and nothing to log in to each day.' },
];

const steps = [
  { title: 'Sign up your shop', body: 'Tell us about your business, your hours and what you sell. We’re starting with a small group.' },
  { title: 'We set you up', body: 'We bring in your products and prices from a spreadsheet, a price list, or an export from Square, Shopify or WooCommerce, and check that AI assistants read them correctly.' },
  { title: 'Put up your sign', body: 'Customers scan it, approve it in their own app, and start asking.' },
];

const examples = [
  { setting: 'Bakery', ask: 'Order a birthday cake for Saturday collection.', gets: 'Pre-orders without the phone ringing.' },
  { setting: 'Deli', ask: 'Is the Stilton in? Put a wedge aside for me.', gets: 'Customers check before the trip.' },
  { setting: 'Farm shop', ask: 'Which farm near me has eggs this week? Reserve a dozen.', gets: 'Reservations without answering the phone.' },
];


const needs = [
  'Your products or services (a spreadsheet is fine)',
  'Prices, and stock if you keep it',
  'Your opening hours',
  'How you take orders today: phone, email, website or booking system',
];

const faqs = [
  {
    q: 'How would Gentifi help my shop?',
    a: 'Customers’ AI can answer “Have you got it today?”, “How much is it?” and “Are you open?” from your own list, and take reservations and pre-orders that the customer confirms, so orders come in without the phone ringing. And when locals ask their AI where to buy, your shop is in the answer, not just the chains.',
  },
  {
    q: 'What do I need to do each day?',
    a: 'Nothing, to stay listed. Orders reach you by email, your own checkout or Telegram, where you tap Accept or Decline. If something sells out, you can tap sold out in Telegram, and one tap puts everything back in stock in the morning. To change a price, edit your Google Sheet or send it in Telegram.',
  },
  {
    q: 'I have no website or online shop. Is this for me?',
    a: 'Yes. That’s who we’re starting with, in Bristol and South Gloucestershire. A spreadsheet of what you sell is enough: we host a page for your shop, and orders still come to you. If you have a developer, they can use our open-source toolkit instead.',
  },
  {
    q: 'What is AI optimisation?',
    a: 'Making sure AI assistants such as ChatGPT, Gemini, Claude and Meta AI can find your business and describe it correctly: what you sell, prices, where you are and when you’re open. We check what they can read about you today, fix your website’s structured data and your Google profile, and put your products into Claude, ChatGPT, Gemini and Grok directly.',
  },
  {
    q: 'Which AI assistants does it work with?',
    a: 'Customers can add your shop to Claude, ChatGPT, Gemini and Grok today, in a minute, and approve it in their AI app. Meta AI can still find you from what they read about you online, which our AI optimisation fixes. We’re testing other AI assistants, and working on one-tap adding.',
  },
  {
    q: 'Can AI order something my customer didn’t want?',
    a: 'No. Every order waits for the customer to confirm it, and nothing can connect to your shop or buy without their approval.',
  },
  {
    q: 'I already sell on Shopify. Is this for me?',
    a: 'Shopify can show your online products in some AI assistants. Gentifi adds what that leaves out: your opening hours and local stock, reservations and bookings, and the events and markets you take part in, alongside the other shops near you.',
  },
  {
    q: 'Am I locked in?',
    a: 'No. Everything we make is open source and uses open standards, so your setup is never tied to us.',
  },
];
---
<Base
  title="AI optimisation for small businesses · Gentifi"
  description="Get found and described correctly by AI assistants. We check what AI sees, fix your website and Google profile, and put your products in Claude, ChatGPT, Gemini and Grok."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <div class="hero__text">
          <span class="eyebrow">AI optimisation for small businesses</span>
          <h1>Let customers ask their AI about you.</h1>
          <p class="hero__lede">
            When customers add your shop to their AI assistant, they can ask what you sell, check prices and opening
            times, and reserve or order. They confirm every order, and it comes to you the way orders do now.
          </p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="/join">Sign up your shop</a>
            <a class="btn btn--ghost" href="/b/demo-business">Try the live demo</a>
          </div>
          <ul class="hero__points">
            <li><Tick size={18} tick="var(--teal)" />No website or developer needed</li>
            <li><Tick size={18} tick="var(--teal)" />Keep your own till and checkout</li>
            <li><Tick size={18} tick="var(--teal)" />Live in Claude, ChatGPT, Gemini and Grok today</li>
          </ul>
        </div>
        <BakeryFilm />
      </div>
    </section>

    <!-- Who it's for -->
    <section class="section section--grey" id="who">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Who it’s for</span>
          <h2>Shops whose customers ask “Have you got it today?”</h2>
          <p>And “Can you put one aside for me?” It suits stock that sells out or changes with the seasons, customers who collect, and regulars who come back.</p>
        </div>
        <ul class="fits">
          {fits.map((f) => (
            <li class="fit">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
              {f.link && <a href={f.link.href}>{f.link.label}</a>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Your day -->
    <section class="section section--teal" id="your-day">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Your day with Gentifi</span>
          <h2>No new daily jobs. Just a tap when something changes.</h2>
          <p>We do the setup. After that, your listing stays up and in step with your list, and you carry on as you do now.</p>
        </div>
        <ul class="day">
          {day.map((d) => (
            <li>
              <h3>{d.title}</h3>
              <p>{d.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- What you get -->
    <section class="section" id="offer">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">What you get</span>
          <h2>Found by AI. Ordered from AI.<br /> Run from your phone.</h2>
          <p>You tell us what you sell. We make sure AI can find it and describe it correctly, and send the orders customers confirm to your phone.</p>
        </div>
        <div class="offer">
          <div>
            <h3 class="offer__label">Today</h3>
            <div class="groups">
              {today.map((g, i) => (
                <div class="group">
                  <h3 class="group__title"><span aria-hidden="true">{i + 1}</span>{g.title}</h3>
                  <ul class="benefits">
                    {g.items.map((b) => (
                      <li>
                        <Tick size={22} tick="var(--white)" />
                        <div><h4>{b.title}</h4><p>{b.body}</p></div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
          <div class="offer__coming">
            <h3 class="offer__label">Coming next</h3>
            <ul class="coming">
              {coming.map((b) => <li><h4>{b.title}</h4><p>{b.body}</p></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticker -->
    <section class="section section--grey">
      <div class="container sticker-row">
        <div class="sticker-row__copy">
          <span class="eyebrow">Gentifi signs</span>
          <h2>Put up your sign. Customers do the rest.</h2>
          <p>
            A window sticker, a counter card for the till, and a badge for your website and emails. Customers scan one
            to add you to their AI assistant, and approve it in their own app.
          </p>
          <WebBadges />
          <p><a class="sticker-row__link" href="/b/demo-business">See what a scan opens</a></p>
        </div>
        <div class="sticker-row__card"><CounterCard /></div>
      </div>
    </section>

    <!-- Steps -->
    <section class="section" id="how">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Getting started</span>
          <h2>Three steps to get started.</h2>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="steps__n" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
        <div class="needs">
          <h3>What we need from you</h3>
          <ul>{needs.map((n) => <li><Tick size={18} tick="var(--white)" /><span>{n}</span></li>)}</ul>
        </div>
        <p class="diy"><a href="/how-it-works">See how it works in detail</a>. Prefer to do it yourself, or have a developer? Our <a href="/toolkit">toolkit</a> is open source.</p>
      </div>
    </section>

    <!-- Examples -->
    <section class="section section--grey" id="examples">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Examples</span>
          <h2>What customers ask.</h2>
        </div>
        <div class="examples">
          {examples.map((e) => (
            <article class="example">
              <span class="example__setting">{e.setting}</span>
              <q>{e.ask}</q>
              <p>{e.gets}</p>
            </article>
          ))}
        </div>
        <p class="b2b">Selling to other businesses? Account prices and approvals are coming next.</p>
        <p class="b2b">Running a show, a market, a high street or a trade body? One connection can cover every trader, exhibitor or member. <a href="/events">See how</a></p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container faq__wrap">
        <div class="section-head">
          <span class="eyebrow">Questions</span>
          <h2>Common questions.</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}{f.link && <> <a href={f.link.href}>{f.link.label}</a></>}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Waitlist -->
    <section class="section section--teal" id="waitlist">
      <div class="container waitlist__grid">
        <div class="section-head">
          <span class="eyebrow">Stay in touch</span>
          <h2>Not ready yet? Stay in touch.</h2>
          <p>Leave your name and email, and we’ll keep you posted. Ready now? <a href="/join">Sign up your shop</a> and join the Genesis cohort, our first group of businesses in Bristol and South Gloucestershire.</p>
        </div>
        <WaitlistForm role="business" />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 8vw, 96px); }
  .hero__grid { display: grid; gap: 40px; align-items: center; justify-items: center; }
  .hero__text { justify-self: stretch; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1fr auto; gap: 64px; } }
  .hero h1 { max-width: 15em; }
  .hero__lede { margin-top: 20px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 38rem; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__points { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 0.95rem; }
  .hero__points li { display: flex; align-items: center; gap: 8px; }

  /* Benefits */
  .offer { display: grid; gap: 32px; }
  @media (min-width: 960px) { .offer { grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: start; } }
  .offer__label { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 18px; }
  .offer__coming { background: var(--grey); border-radius: var(--radius); padding: 24px 26px; }
  .coming { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .coming h4 { font-size: 1.02rem; margin-bottom: 2px; }
  .coming p { color: var(--ink-muted); font-size: 0.95rem; }
  .groups { display: grid; gap: 36px 40px; }
  @media (min-width: 720px) { .groups { grid-template-columns: repeat(2, 1fr); } }
  .group__title { display: flex; align-items: center; gap: 10px; font-size: 1.2rem; margin-bottom: 16px; }
  .group__title span { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--copper); color: var(--teal); font-size: 0.85rem; font-weight: 700; flex-shrink: 0; }
  .benefits { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .benefits li { display: flex; gap: 14px; align-items: flex-start; }
  .benefits li :global(svg) { margin-top: 2px; flex-shrink: 0; }
  .benefits h4 { font-size: 1.1rem; margin-bottom: 4px; }
  .benefits p { color: var(--ink-muted); }

  /* Sticker */
  .sticker-row { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .sticker-row { grid-template-columns: 1.3fr 1fr; gap: 64px; } }
  .sticker-row__copy { display: grid; gap: 16px; justify-items: start; }
  .sticker-row__copy .eyebrow { margin-bottom: 0; }
  .sticker-row__copy > p { color: var(--ink-muted); max-width: 34rem; }
  .sticker-row__link { font-weight: 600; color: var(--teal); }
  .sticker-row__card { max-width: 340px; width: 100%; justify-self: center; }

  /* Steps */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; }
  @media (min-width: 800px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .steps li { display: grid; gap: 10px; align-content: start; }
  .steps__n {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--teal); color: var(--copper);
    display: grid; place-items: center;
    font-weight: 700; font-size: 1.1rem;
  }
  .steps h3 { font-size: 1.2rem; margin-top: 4px; }
  .steps p { color: var(--ink-muted); }
  .needs { margin-top: 36px; padding: 24px 28px; border-radius: var(--radius); background: var(--grey); }
  .needs h3 { font-size: 1.1rem; margin-bottom: 12px; }
  .needs ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  @media (min-width: 720px) { .needs ul { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  .needs li { display: flex; gap: 10px; align-items: flex-start; }
  .needs li :global(svg) { margin-top: 3px; }
  .diy { margin-top: 24px; color: var(--ink-muted); }
  .diy a { color: var(--teal); font-weight: 600; }

  /* Examples */
  .fits { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 720px) { .fits { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .fits { grid-template-columns: repeat(3, 1fr); } }
  .fit { background: var(--white); border-radius: var(--radius); padding: 22px; display: grid; gap: 6px; align-content: start; }
  .fit h3 { font-size: 1.1rem; }
  .fit p { color: var(--ink-muted); }
  .fit a { color: var(--teal); font-weight: 600; }

  /* Your day */
  .day { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 720px) { .day { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .day { grid-template-columns: repeat(4, 1fr); } }
  .day li { border: 1px solid var(--teal-line); border-radius: var(--radius); padding: 22px; display: grid; gap: 6px; align-content: start; }
  .day h3 { font-size: 1.1rem; color: var(--copper); }
  .day p { color: var(--on-teal-muted); }
  .examples { display: grid; gap: 16px; }
  @media (min-width: 720px) { .examples { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .examples { grid-template-columns: repeat(3, 1fr); } }
  .example { background: var(--white); border-radius: var(--radius); padding: 22px; display: grid; gap: 10px; align-content: start; }
  .example__setting { font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); }
  .example q { font-size: 1.05rem; font-weight: 600; line-height: 1.4; }
  .example p { color: var(--ink-muted); font-size: 0.95rem; }
  .b2b { margin-top: 24px; color: var(--ink-muted); }
  .b2b + .b2b { margin-top: 8px; }
  .b2b a { color: var(--teal); font-weight: 600; }

  /* FAQ */
  .faq__wrap { max-width: calc(820px + var(--gutter) * 2); }
  .faq { border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary {
    cursor: pointer;
    list-style: none;
    padding: 20px 40px 20px 0;
    font-weight: 600;
    font-size: 1.05rem;
    position: relative;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 4px; top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .faq details[open] summary::after { content: '\2212'; }
  .faq details p { padding: 0 0 20px; color: var(--ink-muted); max-width: 44rem; }
  .faq details a { color: var(--teal); font-weight: 600; }

  /* Waitlist */
  .waitlist__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .waitlist__grid { grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: start; } }

</style>
