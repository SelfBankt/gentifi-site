---
// The page a phone camera opens after scanning a badge.
// All business data here is fictional demo data.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Tick from '../../components/Tick.astro';
import ApprovalDialog from '../../components/ApprovalDialog.astro';
// Generated by the open-source toolkit from examples/demo-farm-shop.csv (see public/b/demo-business/).
import businessLd from '../../../public/b/demo-business/business.jsonld?raw';

const business = {
  name: 'Hollow Lane Farm Shop',
  initials: 'HL',
  kind: 'Farm shop',
  area: 'Demo listing',
  slug: 'demo-business',
};
const badgeLink = `gentifi.com/b/${business.slug}`;
// The demo connector is live on the Gentifi host
const connectorUrl = `https://mcp.gentifi.com/b/${business.slug}/mcp`;
const files = `/b/${business.slug}`;
const toolkitUrl = 'https://github.com/SelfBankt/gentifi-toolkit';

const stock = [
  { item: 'Free-range eggs, dozen', price: '£3.20', note: 'In stock' },
  { item: 'Sourdough loaf', price: '£4.50', note: 'Baked Fri and Sat' },
  { item: 'Seasonal veg box', price: '£18.00', note: 'Order by Thursday' },
];

const asks = [
  'Have they got eggs this week? Reserve a dozen for Saturday.',
  "What's in the veg box this week, and can I collect after 5?",
  'Order a sourdough loaf for Friday collection.',
];
---
<Base
  title={`Add ${business.name} to your AI assistant · Gentifi demo`}
  description={`Demo page: add ${business.name} to your AI assistant and try it in Claude. Fictional business.`}
>
  <meta slot="head" name="robots" content="noindex" />
  <link slot="head" rel="ard" href={`${files}/ard.json`} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(JSON.parse(businessLd)).replace(/</g, '\\u003c')} />

  <p class="demo-banner">Demo page · fictional business · links and prices are placeholders</p>

  <main id="main" class="scan-page">
    <section class="top">
      <div class="shell">
        <div class="top__bar">
          <Logo href="/" size="sm" />
          <span class="top__link mono">{badgeLink}</span>
        </div>

        <div class="biz">
          <div class="biz__avatar" aria-hidden="true">{business.initials}</div>
          <div>
            <p class="biz__kind">{business.kind} · {business.area}</p>
            <p class="biz__name">{business.name}</p>
            <p class="biz__ready"><Tick size={16} tick="var(--teal)" /> Agent-ready on Gentifi</p>
          </div>
        </div>

        <h1>Add {business.name} to your AI assistant</h1>
        <p class="top__lede">Then ask it what they have, prices and opening times, or to reserve something. You approve the connection and every order.</p>

        <div class="actions">
          <ol class="try">
            <li>
              <strong>Copy this link</strong>
              <code class="try__link">{connectorUrl}</code>
              <button class="btn btn--primary btn--block" type="button" data-copy={connectorUrl}>
                <span data-copy-label>Copy link</span>
              </button>
            </li>
            <li><strong>Add it in Claude</strong><span>Open Settings, then Connectors, and choose Add custom connector. Paste the link, then confirm.</span></li>
            <li><strong>Just ask</strong><span>“Have they got eggs? Reserve a dozen for Saturday.” Nothing is ordered: it’s a fictional shop.</span></li>
          </ol>
          <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
          <p class="actions__url">Using another AI app? Paste the link wherever it lets you add connectors.</p>
          <button class="btn btn--ghost btn--block" type="button" data-approval="approve-demo" data-app="Claude">See what approving looks like</button>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="shell">
        <h2>After you add it</h2>
        <ol class="steps">
          <li class="steps__key">
            <span class="steps__n" aria-hidden="true">1</span>
            <div><strong>You approve it</strong><span>Claude asks you to confirm before anything is added. Nothing installs silently.</span></div>
          </li>
          <li>
            <span class="steps__n" aria-hidden="true">2</span>
            <div><strong>Just ask</strong><span>Your AI can check what they have, prices and opening times, and prepare a reservation.</span></div>
          </li>
          <li>
            <span class="steps__n" aria-hidden="true">3</span>
            <div><strong>You confirm every order</strong><span>Nothing is reserved or bought until you say yes.</span></div>
          </li>
        </ol>
      </div>
    </section>

    <section class="block block--grey">
      <div class="shell">
        <h2>Try asking</h2>
        <ul class="asks">
          {asks.map((a) => <li><q>{a}</q></li>)}
        </ul>

        <h3 class="stock__title">This week at {business.name} <span class="stock__tag">demo data</span></h3>
        <table class="stock">
          <caption class="sr-only">Sample products available to your agent (demo data)</caption>
          <thead><tr><th scope="col">Item</th><th scope="col">Price</th><th scope="col">Availability</th></tr></thead>
          <tbody>
            {stock.map((s) => (
              <tr><td>{s.item}</td><td class="mono">{s.price}</td><td>{s.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="block">
      <div class="shell">
        <h2>Your privacy</h2>
        <div class="privacy">
          <div>
            <h3>The connector can</h3>
            <ul>
              <li>Search the catalogue, prices and stock</li>
              <li>Check opening hours and collection times</li>
              <li>Prepare a reservation or order for you to confirm</li>
            </ul>
          </div>
          <div>
            <h3>It can't</h3>
            <ul>
              <li>See your other chats or files</li>
              <li>Place an order without your confirmation</li>
              <li>Share your details until you choose to book or buy</li>
            </ul>
          </div>
        </div>
        <p class="privacy__note">You can remove the connector at any time in your agent app's settings.</p>
      </div>
    </section>

    <section class="block block--grey">
      <div class="shell">
        <details class="agents">
          <summary>For agents and developers</summary>
          <p>Agents that fetch <code>{badgeLink}</code> find its discovery manifest through a link in the page: machine-readable metadata, not instructions. Adding the connector is always the user's choice.</p>
          <p>These files are real. The <a href={toolkitUrl}>open-source toolkit</a> generated them from a three-row spreadsheet (<a href={`${files}/gentifi.json`}>project file</a>).</p>
          <dl>
            <dt>Discovery (ARD)</dt><dd><a href={`${files}/ard.json`}><code>{badgeLink}/ard.json</code></a></dd>
            <dt>MCP server card</dt><dd><a href={`${files}/mcp/server-card.json`}><code>{badgeLink}/mcp/server-card.json</code></a></dd>
            <dt>Agent Skill</dt><dd><a href={`${files}/SKILL.md`}><code>{badgeLink}/SKILL.md</code></a></dd>
            <dt>schema.org</dt><dd><a href={`${files}/business.jsonld`}><code>{badgeLink}/business.jsonld</code></a></dd>
            <dt>Window sticker</dt><dd><a href={`${files}/badge.svg`}><code>{badgeLink}/badge.svg</code></a></dd>
            <dt>MCP connector</dt><dd><code>{connectorUrl}</code> <span class="agents__live">live</span></dd>
          </dl>
        </details>
      </div>
    </section>

    <footer class="scan-foot">
      <div class="shell">
        <p>Is this your business? <a href="/#waitlist">Get your own Gentifi sign</a></p>
        <p class="scan-foot__small"><a href="/">What is Gentifi?</a></p>
      </div>
    </footer>
  </main>

  <ApprovalDialog
    id="approve-demo"
    name={business.name}
    initials={business.initials}
    via={`Connector via Gentifi · ${badgeLink}`}
    abilities={['Search products, prices and stock', 'Prepare reservations and orders for you to confirm']}
  />
</Base>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyLabel = copyBtn?.querySelector('[data-copy-label]');
  const copyStatus = document.querySelector('[data-copy-status]');
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.dataset.copy ?? '';
    let msg = 'Link copied';
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      msg = 'Copy failed: select the link below';
    }
    if (copyLabel) copyLabel.textContent = msg;
    if (copyStatus) copyStatus.textContent = msg;
    setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copy connector link'; }, 2500);
  });
</script>

<style>
  .scan-page { background: var(--white); }
  .shell { width: 100%; max-width: 560px; margin-inline: auto; padding-inline: var(--gutter); }

  .top { background: var(--teal); color: var(--white); padding-block: 20px 36px; }
  .top__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 28px; }
  .top__link { font-size: 0.75rem; color: var(--on-teal-muted); overflow-wrap: anywhere; text-align: right; }

  .biz { display: flex; gap: 14px; align-items: center; margin-bottom: 24px; }
  .biz__avatar {
    width: 64px; height: 64px; flex-shrink: 0;
    border-radius: 18px;
    background: var(--grey);
    color: var(--teal);
    display: grid; place-items: center;
    font-weight: 700; font-size: 1.3rem;
  }
  .biz__avatar--sm { width: 48px; height: 48px; border-radius: 14px; font-size: 1rem; }
  .biz__kind { font-family: var(--font-mono); font-size: 0.78rem; color: var(--on-teal-muted); }
  .biz__name { font-size: 1.2rem; font-weight: 700; line-height: 1.25; }
  .biz__ready { display: flex; gap: 6px; align-items: center; font-size: 0.85rem; color: var(--copper); margin-top: 2px; }

  h1 { font-size: clamp(1.7rem, 7vw, 2.2rem); }
  .top__lede { margin-top: 12px; color: var(--on-teal-muted); }

  .actions { display: grid; gap: 12px; margin-top: 28px; }
  .actions .btn { min-height: 56px; font-size: 1.05rem; }
  .actions__url { font-size: 0.82rem; color: var(--on-teal-muted); margin-top: 4px; }
  .actions__url code { color: var(--white); overflow-wrap: anywhere; }

  .block { padding-block: 40px; }
  .block--grey { background: var(--grey); }
  .block h2 { font-size: 1.4rem; margin-bottom: 20px; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .steps li {
    display: flex; gap: 14px; align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
  }
  .steps li div { display: grid; gap: 2px; }
  .steps li span:not(.steps__n) { color: var(--ink-muted); font-size: 0.95rem; }
  .steps__n {
    width: 28px; height: 28px; flex-shrink: 0;
    border-radius: 50%;
    background: var(--grey);
    display: grid; place-items: center;
    font-family: var(--font-mono); font-weight: 500; font-size: 0.85rem;
  }
  .steps__key { background: var(--teal); border-color: var(--teal) !important; color: var(--white); }
  .steps__key span:not(.steps__n) { color: var(--on-teal-muted) !important; }
  .steps__key .steps__n { background: var(--copper); color: var(--teal); }

  .asks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .asks li { background: var(--white); border-radius: var(--radius); padding: 14px 16px; font-weight: 600; }

  .stock__title { margin: 32px 0 12px; font-size: 1.05rem; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .stock__tag {
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.06em;
    border: 1px dashed var(--ink-muted); color: var(--ink-muted);
    padding: 1px 6px; border-radius: 6px;
  }
  .stock { width: 100%; border-collapse: collapse; background: var(--white); border-radius: var(--radius); overflow: hidden; font-size: 0.92rem; }
  .stock th, .stock td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--grey); vertical-align: top; }
  .stock th { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-muted); }
  .stock tr:last-child td { border-bottom: 0; }

  .privacy { display: grid; gap: 20px; }
  @media (min-width: 480px) { .privacy { grid-template-columns: 1fr 1fr; } }
  .privacy h3 { font-size: 1rem; margin-bottom: 8px; }
  .privacy ul { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; color: var(--ink-muted); font-size: 0.95rem; }
  .privacy__note { margin-top: 20px; font-size: 0.9rem; color: var(--ink-muted); }

  .agents summary { cursor: pointer; font-weight: 600; min-height: 32px; }
  .agents p { margin-top: 12px; font-size: 0.92rem; color: var(--ink-muted); }
  .agents dl { margin: 16px 0 0; display: grid; gap: 4px; font-size: 0.88rem; }
  .agents dt { font-weight: 600; margin-top: 8px; }
  .agents dd { margin: 0; overflow-wrap: anywhere; }
  .agents code { font-size: 0.82rem; }
  .agents a { color: var(--teal); }
  .agents__soon { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; border: 1px dashed var(--ink-muted); color: var(--ink-muted); padding: 1px 6px; border-radius: 6px; white-space: nowrap; }

  .scan-foot { background: var(--teal); color: var(--on-teal-muted); padding-block: 32px 40px; font-size: 0.95rem; }
  .scan-foot a { color: var(--white); }
  .scan-foot__small { margin-top: 8px; font-size: 0.85rem; }

  .agents__live { font-family: var(--font-mono); font-size: 0.75rem; padding: 1px 8px; border-radius: 6px; background: var(--copper); color: var(--teal); }
  .try { list-style: none; counter-reset: t; margin: 4px 0 0; padding: 16px; display: grid; gap: 14px; text-align: left; background: var(--grey); color: var(--ink); border-radius: 14px; font-size: 0.92rem; }
  .try li { counter-increment: t; display: grid; gap: 6px; padding-left: 34px; position: relative; }
  .try li::before { content: counter(t); position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--teal); color: var(--copper); display: grid; place-items: center; font-weight: 700; font-size: 0.8rem; }
  .try__link { overflow-wrap: anywhere; font-size: 0.85rem; }
</style>
