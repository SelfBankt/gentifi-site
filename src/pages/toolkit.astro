---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CopyLine from '../components/CopyLine.astro';
import Tick from '../components/Tick.astro';

// All real: the toolkit runs, downloads and sets up straight from GitHub today.
const githubUrl = 'https://github.com/SelfBankt/gentifi-toolkit';
const issuesUrl = `${githubUrl}/issues`;
const toolkitZip = `${githubUrl}/archive/refs/heads/main.zip`;
const toolkitInit = 'npx github:SelfBankt/gentifi-toolkit init --from csv --file catalogue.csv --name "Your Business"';
const toolkitHelp = 'npx github:SelfBankt/gentifi-toolkit --help';
const toolkitSkill = 'Set up https://raw.githubusercontent.com/SelfBankt/gentifi-toolkit/main/SKILL.md';
const toolkitSkillPage = `${githubUrl}/blob/main/SKILL.md`;
const toolkitClone = 'git clone https://github.com/SelfBankt/gentifi-toolkit.git';
const tryAgent = 'claude mcp add --transport http my-shop http://localhost:8787/mcp';

// Mirrors the real CLI (src/commands/*.js in the toolkit repo), version 0.1.
const commands = [
  {
    name: 'init',
    usage: 'gentifi init --from csv --file <path or URL> --name <business>',
    summary: 'Import a catalogue and create a gentifi.json project. A spreadsheet or a published Google Sheet works today.',
    status: 'Works for csv',
    options: [
      ['--from', 'csv today; shopify, woocommerce and booking are planned'],
      ['--hours, --area, --email…', 'Business details: never guessed, always asked'],
    ],
  },
  {
    name: 'sync',
    usage: 'gentifi sync',
    summary: 'Refresh prices and stock from the same spreadsheet, and show what changed.',
    status: 'Works',
    options: [['--file', 'Read from a different file or link this time']],
  },
  {
    name: 'check',
    usage: 'gentifi check [--url <link>]',
    summary: 'The Gentified test: calls the business’s tools like an agent would, and checks every order ends with the customer confirming.',
    status: 'Works',
    options: [['--url', 'Test a published business by its link'], ['--json', 'Results for scripts and coding agents']],
  },
  {
    name: 'build',
    usage: 'gentifi build [--out <dir>]',
    summary: 'Write every agent format: discovery manifest, server card, Agent Skill, schema.org data, scan-to-add page and badge.',
    status: 'Works',
    options: [['--out', 'Output directory (default ./dist)']],
  },
  {
    name: 'serve',
    usage: 'gentifi serve [--port <n>] [--stdio]',
    summary: 'Run the MCP connector. Speaks MCP 2026-07-28 and still serves 2025-11-25 clients.',
    status: 'Works',
    options: [['--stdio', 'For local agent apps'], ['--host', 'Listen address, for running behind a web server']],
  },
  {
    name: 'publish',
    usage: 'gentifi publish --self-host <dir>',
    summary: 'Lay out the files for your own web server, including /.well-known/. Publishing to the Gentifi network comes later.',
    status: 'Self-hosting works',
    options: [['--self-host', 'Directory to write the site to']],
  },
  {
    name: 'collection check',
    usage: 'gentifi collection check <file or URL> [--verify]',
    summary: 'Check a Collection (draft 0.2) and confirm each member links back to it.',
    status: 'Works',
    options: [['--verify', 'Fetch each member’s own manifest (rule 1)']],
  },
];

const outputs = [
  { file: 'MCP connector (gentifi serve)', output: 'search_catalogue, check_availability, prepare_order and get_business_info, all read-only' },
  { file: '.well-known/ard.json', output: 'Discovery manifest: tells agents this business has a connector and a skill' },
  { file: 'mcp/server-card.json', output: 'Where and how to connect, before connecting' },
  { file: 'SKILL.md', output: 'Instructions and a catalogue snapshot for headless agents' },
  { file: 'business.jsonld', output: 'The business and its offers for search engines and AI search' },
  { file: 'index.html and badge.svg', output: 'The scan-to-add page, and a window sticker whose code opens it' },
  { file: '.well-known/agent-card.json', output: 'Only for businesses that run an A2A endpoint' },
];

const standards = [
  { layer: 'Tools and data', standard: 'Model Context Protocol (MCP) 2026-07-28', href: 'https://modelcontextprotocol.io' },
  { layer: 'Discovery', standard: 'Agentic Resource Discovery v0.91 (ard.json)', href: 'https://agenticresourcediscovery.org/spec' },
  { layer: 'Connection details', standard: 'MCP Server Cards', href: 'https://modelcontextprotocol.io/seps/2127-mcp-server-cards' },
  { layer: 'Agent instructions', standard: 'Agent Skills (SKILL.md)', href: 'https://agentskills.io' },
  { layer: 'Search', standard: 'schema.org LocalBusiness and Offer', href: 'https://schema.org/LocalBusiness' },
  { layer: 'Agent to agent', standard: 'A2A 1.0, when the business runs an endpoint', href: 'https://a2a-protocol.org' },
  { layer: 'Groups of businesses', standard: 'Business Collections draft 0.2', href: '/standards' },
  { layer: 'Commerce', standard: 'UCP, where the business’s checkout supports it (planned)' },
];

const done = [
  { title: 'Connector generator', body: 'A spreadsheet or Google Sheet becomes an MCP connector with search, availability and order tools.' },
  { title: 'Checkout hand-off', body: 'Orders end on the business’s own checkout, booking page, email or phone, confirmed by the customer.' },
  { title: 'SKILL.md and discovery', body: 'Generated from the same data, in the formats agents read.' },
  { title: 'Link and QR code', body: 'A scan-to-add page and a printable sticker for each business.' },
  { title: 'The Gentified test', body: 'Checks a business locally, or any published one by its link.' },
];

const next = [
  { title: 'More sources', body: 'Shopify, WooCommerce and booking systems.' },
  { title: 'Gentifi network hosting', body: 'The connector and page hosted at gentifi.com/b/<business>.' },
  { title: 'Simple dashboard', body: 'Agent questions, orders and revenue.' },
  { title: 'UCP checkout', body: 'For businesses whose checkout supports it.' },
];
---
<Base
  title="Gentifi Toolkit: make any business agent-ready"
  description="The open-source Gentifi Toolkit turns a business's product list into an MCP connector, discovery manifest, server card, Agent Skill, schema.org data and a scan-to-add sticker, and tests it like an agent would."
>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero section--teal">
      <div class="container hero__grid">
        <div class="hero__copy">
          <span class="eyebrow">Open source · Apache 2.0 · Version 0.1</span>
          <h1>The Gentifi Toolkit</h1>
          <p class="hero__lede">
            An open-source tool that turns a business's products, prices and stock into everything AI agents need to
            find, price, book and buy, then tests it the way an agent would. Built on open standards, so it works with
            any agent.
          </p>
          <p class="status"><span class="status__dot" aria-hidden="true"></span>Early preview: spreadsheets work end to end. Shopify, WooCommerce and booking imports are next.</p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href={githubUrl}>View on GitHub</a>
            <a class="btn btn--ghost" href={toolkitZip}>Download .zip</a>
          </div>
          <div class="hero__install">
            <p>Or run it now, nothing to install:</p>
            <CopyLine text={toolkitHelp} prompt="$" label="Copy command" />
          </div>
        </div>

        <figure class="term" aria-label="Output of gentifi check for the demo farm shop">
          <div class="term__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <pre><code><span class="t-prompt">$</span> gentifi check
Gentified test for Hollow Lane Farm Shop

<span class="t-dim">…</span>
Agent test
  <span class="t-ok">✓</span> MCP 2026-07-28: server/discover answers
  <span class="t-ok">✓</span> Older agents (MCP 2025-11-25) can connect too
  <span class="t-ok">✓</span> 4 tools, each with a title and safety hints
  <span class="t-ok">✓</span> Agents can find every item by name
  <span class="t-ok">✓</span> Every order ends with the customer
    confirming (email: Send the reservation request)
  <span class="t-ok">✓</span> Bad requests get a clear error, not an order

<span class="t-cmd">Gentified ✓</span> Agents can find this business, read
its prices and prepare orders the customer confirms.</code></pre>
          <figcaption>Real output for the fictional demo farm shop, shortened</figcaption>
        </figure>
      </div>
    </section>

    <!-- Start -->
    <section class="section" id="start">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Get started</span>
          <h2>Three ways to start, all in one line.</h2>
        </div>
        <div class="starts">
          <article class="start">
            <span class="start__tag">Run it</span>
            <h3>With npx</h3>
            <p>Nothing to install. Needs Node.js 20 or later and a spreadsheet with a name and a price on each row.</p>
            <CopyLine text={toolkitInit} prompt="$" tone="light" label="Copy command" />
          </article>
          <article class="start start--key">
            <span class="start__tag">Ask your agent</span>
            <h3>With a coding agent</h3>
            <p>Paste this into Claude Code or any coding agent. It asks for your business details, runs the test with you, and asks before anything goes public.</p>
            <CopyLine text={toolkitSkill} prompt="$" label="Copy instruction" />
            <a class="start__link" href={toolkitSkillPage}>Read the skill</a>
          </article>
          <article class="start">
            <span class="start__tag">Clone it</span>
            <h3>From source</h3>
            <p>Read the code, run the tests and contribute. No dependencies.</p>
            <CopyLine text={toolkitClone} prompt="$" tone="light" label="Copy command" />
          </article>
        </div>
        <div class="try">
          <div>
            <h3>See it from the customer's side</h3>
            <p>Run <code>gentifi serve</code>, add the connector to your own agent, and ask it what's in stock. In Claude Code:</p>
          </div>
          <CopyLine text={tryAgent} prompt="$" tone="light" label="Copy command" />
        </div>
      </div>
    </section>

    <!-- Commands -->
    <section class="section section--grey" id="commands">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Commands</span>
          <h2>From spreadsheet to agent-ready.</h2>
          <p>Every command has <code>--help</code>. Exit code 2 means "planned, not built yet", so scripts and coding agents can tell. For the bigger picture, see <a href="/how-it-works">how it works in detail</a>.</p>
        </div>
        <ol class="cmds">
          {commands.map((c, i) => (
            <li class="cmd">
              <div class="cmd__head">
                <span class="cmd__n" aria-hidden="true">{i + 1}</span>
                <h3><code>gentifi {c.name}</code></h3>
                <span class="cmd__status"><Tick size={14} tick="var(--white)" circle="var(--teal)" />{c.status}</span>
              </div>
              <p>{c.summary}</p>
              <code class="cmd__usage">{c.usage}</code>
              <dl class="cmd__opts">
                {c.options.map(([flag, desc]) => (
                  <div><dt><code>{flag}</code></dt><dd>{desc}</dd></div>
                ))}
              </dl>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Outputs -->
    <section class="section" id="outputs">
      <div class="container two-col">
        <div class="section-head">
          <span class="eyebrow">What it generates</span>
          <h2>One catalogue in. Every agent format out.</h2>
          <p>Everything the toolkit writes follows the published spec for that format, so it works without Gentifi. It won't publish a format that points at nothing.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">What the toolkit generates</caption>
            <thead><tr><th scope="col">File</th><th scope="col">What it's for</th></tr></thead>
            <tbody>
              {outputs.map((o) => <tr><th scope="row"><code>{o.file}</code></th><td>{o.output}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Standards -->
    <section class="section section--grey" id="standards">
      <div class="container two-col">
        <div class="section-head">
          <span class="eyebrow">Open standards</span>
          <h2>Built on standards, not new formats.</h2>
          <p>Checked against the current versions in October 2026. Where there's a gap, we propose a neutral fix: <a href="/standards">see the Business Collections draft</a>.</p>
        </div>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">Open standards the toolkit builds on</caption>
            <thead><tr><th scope="col">Layer</th><th scope="col">Standard</th></tr></thead>
            <tbody>
              {standards.map((s) => (
                <tr>
                  <th scope="row">{s.layer}</th>
                  <td>{s.href ? <a href={s.href}>{s.standard}</a> : s.standard}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Rules -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Design rules</span>
          <h2>Built so customers stay in control.</h2>
        </div>
        <ul class="rules">
          <li><Tick size={20} tick="var(--teal)" /><div><strong>The customer always approves.</strong> Every tool is read-only. Connecting an agent to a business, and every order, is confirmed by the customer in their own app or on the business's own checkout.</div></li>
          <li><Tick size={20} tick="var(--teal)" /><div><strong>Information, not instructions.</strong> Generated files say "this business has a connector, here it is". The Gentified test fails any business text that tries to instruct an agent.</div></li>
          <li><Tick size={20} tick="var(--teal)" /><div><strong>Real data only.</strong> Prices, stock and hours come from the business. Missing details are reported, never invented.</div></li>
          <li><Tick size={20} tick="var(--teal)" /><div><strong>Self-host or not.</strong> Lay out files for your own domain, including <code>/.well-known/</code>, or publish to the Gentifi network when it opens.</div></li>
        </ul>
      </div>
    </section>

    <!-- Roadmap -->
    <section class="section section--grey" id="roadmap">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Roadmap</span>
          <h2>What's built, and what's next.</h2>
          <p>Start small: get a handful of businesses buyable from agents, and prove it.</p>
        </div>
        <h3 class="roadmap__label">In version 0.1</h3>
        <ol class="roadmap">
          {done.map((r) => (
            <li class="roadmap__done"><h3>{r.title}</h3><p>{r.body}</p></li>
          ))}
        </ol>
        <h3 class="roadmap__label">Next</h3>
        <ol class="roadmap roadmap--next">
          {next.map((r) => (
            <li><h3>{r.title}</h3><p>{r.body}</p></li>
          ))}
        </ol>
        <div class="contribute">
          <div>
            <h3>Help build it</h3>
            <p>Tell us which catalogue source, booking system or agent you need, or pick up an importer.</p>
          </div>
          <div class="contribute__actions">
            <a class="btn btn--teal" href={issuesUrl}>Open an issue</a>
            <a class="btn btn--outline" href={githubUrl}>View on GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Hosted -->
    <section class="section section--teal">
      <div class="container hosted">
        <div>
          <span class="eyebrow">Rather not run it yourself?</span>
          <h2>Gentifi can host it for you.</h2>
          <p>We import your catalogue, run the connector, put you on the Gentifi network and send your signs. No website or developer needed.</p>
        </div>
        <div class="hosted__actions">
          <a class="btn btn--primary" href="/join">Sign up your shop</a>
          <a class="btn btn--ghost" href="/businesses">See the hosted offer</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 8vw, 96px); }
  .hero__grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1040px) { .hero__grid { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .hero__copy { min-width: 0; }
  .hero__lede { margin-top: 20px; font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--on-teal-muted); max-width: 36rem; }
  .status {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 20px;
    padding: 6px 12px;
    border: 1px solid var(--teal-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--on-teal-muted);
  }
  .status__dot { width: 8px; height: 8px; flex-shrink: 0; border-radius: 50%; background: var(--copper); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__install { margin-top: 20px; max-width: 34rem; display: grid; gap: 8px; }
  .hero__install p { font-size: 0.9rem; color: var(--on-teal-muted); }

  .term { margin: 0; min-width: 0; }
  .term__bar { display: flex; gap: 6px; padding: 12px 16px; background: var(--teal-line); border-radius: var(--radius) var(--radius) 0 0; }
  .term__bar span { width: 10px; height: 10px; border-radius: 50%; background: var(--teal-raised); }
  .term pre {
    margin: 0;
    padding: 20px;
    background: #032F38;
    border: 1px solid var(--teal-line);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    color: var(--white);
    font-size: 0.8rem;
    line-height: 1.6;
    overflow-x: auto;
  }
  .t-prompt, .t-cmd { color: var(--copper); }
  .t-ok { color: var(--copper); }
  .t-dim { color: var(--on-teal-muted); }
  .term figcaption { margin-top: 10px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--on-teal-muted); text-align: right; }

  /* Starts */
  .starts { display: grid; gap: 16px; }
  .start {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .start > p { color: var(--ink-muted); }
  .start__tag { font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); }
  .start :global(.copyline) { margin-top: auto; }
  @media (min-width: 960px) {
    .start {
      display: grid;
      grid-template-columns: 9rem 1fr 1.5fr;
      grid-template-areas: 'tag title cmd' 'tag text cmd' 'tag link cmd';
      column-gap: 32px;
      row-gap: 6px;
      align-items: center;
      padding: 24px 28px;
    }
    .start__tag { grid-area: tag; align-self: start; padding-top: 4px; }
    .start h3 { grid-area: title; }
    .start > p { grid-area: text; }
    .start__link { grid-area: link; }
    .start :global(.copyline) { grid-area: cmd; margin-top: 0; }
  }
  .start--key { background: var(--teal); border-color: var(--teal); color: var(--white); }
  .start--key > p { color: var(--on-teal-muted); }
  .start--key .start__tag { color: var(--copper); }
  .start__link { color: var(--white); font-size: 0.92rem; }

  .try { margin-top: 24px; display: grid; gap: 14px; align-items: center; padding: 24px 28px; background: var(--grey); border-radius: var(--radius); }
  @media (min-width: 960px) { .try { grid-template-columns: 1fr 1.2fr; gap: 32px; } }
  .try h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .try p { color: var(--ink-muted); }
  .try code { font-size: 0.9em; }

  /* Commands */
  .cmds { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 860px) { .cmds { grid-template-columns: repeat(2, 1fr); } }
  .cmd { background: var(--white); border-radius: var(--radius); padding: 24px; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .cmd__head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cmd__head h3 { font-size: 1.1rem; }
  .cmd__head h3 code { font-family: var(--font-mono); font-weight: 500; }
  .cmd__n {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--teal); color: var(--copper);
    display: grid; place-items: center;
    font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500;
  }
  .cmd__status {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 3px 8px; border-radius: 6px; background: var(--grey); color: var(--teal);
  }
  .cmd > p { color: var(--ink-muted); }
  .cmd__usage {
    display: block;
    padding: 10px 12px;
    background: var(--grey);
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    overflow-x: auto;
    white-space: nowrap;
  }
  .cmd__opts { margin: 0; display: grid; gap: 8px; font-size: 0.9rem; }
  .cmd__opts div { display: grid; grid-template-columns: max-content 1fr; gap: 12px; }
  .cmd__opts dt code { font-size: 0.85rem; font-weight: 500; }
  .cmd__opts dd { margin: 0; color: var(--ink-muted); }
  @media (max-width: 420px) { .cmd__opts div { grid-template-columns: 1fr; gap: 0; } }

  /* Tables */
  .two-col { display: grid; gap: 8px; }
  @media (min-width: 960px) { .two-col { grid-template-columns: 0.8fr 1.2fr; gap: 56px; align-items: start; } }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--white); }
  table { width: 100%; border-collapse: collapse; min-width: 440px; }
  th, td { text-align: left; vertical-align: top; padding: 14px 18px; border-bottom: 1px solid var(--grey); }
  thead th { background: var(--teal); color: var(--white); font-size: 0.95rem; }
  tbody th { font-weight: 600; width: 38%; }
  tbody th code { font-size: 0.85rem; font-weight: 500; overflow-wrap: anywhere; }
  td { color: var(--ink-muted); }
  td a { color: var(--teal); font-weight: 600; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }

  /* Rules */
  .rules { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 860px) { .rules { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  .rules li { display: flex; gap: 14px; align-items: flex-start; border: 1px solid var(--border); border-radius: var(--radius); padding: 22px 24px; color: var(--ink-muted); }
  .rules li :global(svg) { margin-top: 3px; }
  .rules strong { color: var(--ink); }
  .rules code { font-size: 0.9em; }

  /* Roadmap */
  .roadmap__label { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); margin: 0 0 12px; }
  .roadmap + .roadmap__label { margin-top: 28px; }
  .roadmap { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: r; }
  @media (min-width: 720px) { .roadmap { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .roadmap { grid-template-columns: repeat(5, 1fr); } .roadmap--next { grid-template-columns: repeat(4, 1fr); } }
  .roadmap li { background: var(--white); border-radius: var(--radius); padding: 22px; display: grid; gap: 8px; align-content: start; counter-increment: r; }
  .roadmap li::before { content: counter(r, decimal-leading-zero); font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-muted); }
  .roadmap .roadmap__done { box-shadow: inset 0 0 0 2px var(--teal); }
